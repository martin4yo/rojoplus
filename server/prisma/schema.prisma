model ProductoBuffet {
  id               Int                  @id @default(autoincrement())
  productoId       Int                  @unique @map("producto_id")
  categoriaMenuId  Int                  @map("categoria_menu_id")
  nombre           String
  descripcion      String?
  precio           Decimal              @db.Decimal(12, 2)
  imagen           String?
  disponible       Boolean              @default(true)
  destacado        Boolean              @default(false)
  orden            Int                  @default(0)
  activo           Boolean              @default(true)
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  codigoBarras     String?              @map("codigo_barras")
  tiposVenta       String[]             @default(["BUFFET", "KIOSCO"]) @map("tipos_venta")
  cuentaContableId Int?                 @map("cuenta_contable_id")
  itemsComanda     ItemComanda[]
  itemsTakeAway    ItemPedidoTakeAway[]
  categoriaMenu    CategoriaMenu        @relation(fields: [categoriaMenuId], references: [id])
  producto         Producto             @relation(fields: [productoId], references: [id])
  cuentaContable   CuentaContable?      @relation(fields: [cuentaContableId], references: [id])
  gruposOpciones   GrupoOpcionProducto[]
  esOpcionDe       OpcionProducto[]     @relation("ProductoComoOpcion") // Este producto puede ser opción de otros (ej: empanada individual es opción de docena)

