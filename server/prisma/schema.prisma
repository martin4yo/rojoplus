  saldosAplicados   AplicacionSaldo[]    @relation("SaldoAplicado")
  cargos            Cargo[]
  movimientos       MovimientoCaja[]
  mediosPago        PagoMedioPago[]
  caja              Caja                 @relation(fields: [cajaId], references: [id])
  centroCosto       CentroCosto?         @relation(fields: [centroCostoId], references: [id])
  cobrador          Cobrador?            @relation(fields: [cobradorId], references: [id])
