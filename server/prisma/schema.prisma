  createdAt      DateTime         @default(now()) @map("created_at")
  conciliacion   Conciliacion?    @relation(fields: [conciliacionId], references: [id])
  extracto       ExtractoBancario @relation(fields: [extractoId], references: [id])

  @@index([extractoId])
  @@index([fecha])
  @@index([conciliado])
