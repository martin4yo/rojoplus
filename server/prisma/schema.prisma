  id               Int                @id @default(autoincrement())
  codigo           String             @unique
  nombre           String
  descripcion      String?
  categoriaId      Int?               @map("categoria_id")
  precioCompra     Decimal?           @map("precio_compra") @db.Decimal(12, 2)
  precioVenta      Decimal?           @map("precio_venta") @db.Decimal(12, 2)
  conceptoCompraId Int?               @map("concepto_compra_id")
  conceptoVentaId  Int?               @map("concepto_venta_id")
  activo           Boolean            @default(true)
