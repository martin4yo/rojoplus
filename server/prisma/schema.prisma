  nombreReceptor       String?   @map("nombre_receptor")
  domicilioReceptor    String?   @map("domicilio_receptor")
  condicionIvaReceptor String?   @map("condicion_iva_receptor")
  neto                 Decimal   @default(0) @db.Decimal(12, 2)
  netoNoGravado        Decimal   @default(0) @map("neto_no_gravado") @db.Decimal(12, 2)
  exento               Decimal   @default(0) @db.Decimal(12, 2)
  iva21                Decimal   @default(0) @db.Decimal(12, 2)
  iva105               Decimal   @default(0) @db.Decimal(12, 2)
  iva27                Decimal   @default(0) @db.Decimal(12, 2)
  percepcionesIva      Decimal   @default(0) @map("percepciones_iva") @db.Decimal(12, 2)
  percepcionesIibb     Decimal   @default(0) @map("percepciones_iibb") @db.Decimal(12, 2)
  otrosImpuestos       Decimal   @default(0) @map("otros_impuestos") @db.Decimal(12, 2)
  total                Decimal   @db.Decimal(12, 2)
  moneda               String    @default("PES")
  cotizacion           Decimal   @default(1) @db.Decimal(10, 4)
  cajaId               Int?      @map("caja_id")
  comandaId            Int?      @map("comanda_id")
  pedidoTakeawayId     Int?      @map("pedido_takeaway_id")
  movimientoContableId Int?      @map("movimiento_contable_id")
