}

model MovimientoCaja {
  id                      Int            @id @default(autoincrement())
  numero                  String         @unique
  cajaId                  Int            @map("caja_id")
  fecha                   DateTime       @default(now())
  fechaOperacion          DateTime?      @map("fecha_operacion")
  tipo                    String
  cuentaContableId        Int            @map("cuenta_contable_id")
  monto                   Decimal        @db.Decimal(12, 2)
  pagoId                  Int?           @map("pago_id")
  cajaDestinoId           Int?           @map("caja_destino_id")
  movimientoRelacionadoId Int?           @map("movimiento_relacionado_id")
  concepto                String
  descripcion             String?
  comprobanteNro          String?        @map("comprobante_nro")
  comprobanteTipo         String?        @map("comprobante_tipo")
  estado                  String         @default("CONFIRMADO")
  fechaAnulacion          DateTime?      @map("fecha_anulacion")
  motivoAnulacion         String?        @map("motivo_anulacion")
  anuladoPor              Int?           @map("anulado_por")
  conciliado              Boolean        @default(false)
  conciliacionId          Int?           @map("conciliacion_id")
  registradoPor           Int            @map("registrado_por")
  createdAt               DateTime       @default(now()) @map("created_at")
  updatedAt               DateTime       @updatedAt @map("updated_at")
  caja                    Caja           @relation(fields: [cajaId], references: [id])
  conciliacion            Conciliacion?  @relation(fields: [conciliacionId], references: [id])
  cuentaContable          CuentaContable @relation(fields: [cuentaContableId], references: [id])
  pago                    Pago?          @relation(fields: [pagoId], references: [id])
  registrador             Admin          @relation(fields: [registradoPor], references: [id])

  @@index([cajaId])
  @@index([fecha])
  @@index([tipo])
  @@index([cuentaContableId])
  @@index([conciliado])
  @@map("movimientos_caja")
}

model ExtractoBancario {
  id                  Int                  @id @default(autoincrement())
  cajaId              Int                  @map("caja_id")
  numero              String               @unique
  periodoDesde        DateTime             @map("periodo_desde")
  periodoHasta        DateTime             @map("periodo_hasta")
