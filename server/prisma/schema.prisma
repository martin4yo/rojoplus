  tenantId    Int      @map("tenant_id")
  @@index([periodoId])
  @@index([socioId])
  @@index([grupoFamiliarId])
  @@index([categoria])
  @@index([estado])
  @@index([fechaVencimiento])
  @@index([cargoOrigenId])
  @@index([centroCostoId])
  @@index([loteId])
  @@index([tenantId])
  @@map("cargos")
}

