  anuladoPor        Int?                 @map("anulado_por")
  origen            String               @default("MOSTRADOR")
  linkPagoId        Int?                 @map("link_pago_id")
  detalleCobranzaId Int?                 @map("detalle_cobranza_id")
  observaciones     String?
  registradoPor     Int                  @map("registrado_por")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  comprobanteUrl    String?              @map("comprobante_url")
