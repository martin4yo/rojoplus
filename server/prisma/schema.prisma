  tipo                 String    // FACTURA_A, FACTURA_B, FACTURA_C, NOTA_CREDITO_A, etc.
  tipoAfip             Int       @map("tipo_afip") // Código AFIP: 1=Factura A, 6=Factura B, 11=Factura C, etc.
