model ArchivoDebito {
  id                Int                   @id @default(autoincrement())
  configuracionId   Int                   @map("configuracion_id")
  numero            String                @unique
  periodoAnio       Int                   @map("periodo_anio")
  periodoMes        Int                   @map("periodo_mes")
