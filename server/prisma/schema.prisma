  tenantId    Int      @map("tenant_id")
  @@index([socioId])
  @@index([habilitacionTemporalId])
  @@index([dispositivoId])
  @@index([fecha])
  @@index([resultado])
  @@index([tenantId])
  @@map("registros_acceso")
