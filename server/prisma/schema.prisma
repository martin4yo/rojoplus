// =============================================================================
// MODULO CONTABILIDAD - MOVIMIENTOS CONTABLES
// =============================================================================

// Tipos de movimiento: FACTURA_COMPRA, FACTURA_VENTA, NOTA_CREDITO_PROVEEDOR,
// NOTA_CREDITO_CLIENTE, NOTA_DEBITO_PROVEEDOR, NOTA_DEBITO_CLIENTE,
// ORDEN_PAGO, PAGO, RECIBO_COBRO

model MovimientoContable {
  id     Int    @id @default(autoincrement())
  numero String @unique
  tipo   String // FACTURA_COMPRA, FACTURA_VENTA, etc.

  // Referencia flexible: Entidad (proveedor/cliente) O Socio
  entidadId Int? @map("entidad_id")
  socioId   Int? @map("socio_id")

  // Vinculo opcional con Orden de Compra o Pedido
  ordenCompraId Int? @map("orden_compra_id")
  pedidoId      Int? @map("pedido_id")

  fecha            DateTime  @default(now())
  fechaVencimiento DateTime? @map("fecha_vencimiento")

  // Datos de comprobante AFIP
  tipoComprobante   String? @map("tipo_comprobante") // A, B, C, M, E
  puntoVenta        String? @map("punto_venta")
  numeroComprobante String? @map("numero_comprobante")

  // Montos
  subtotal       Decimal @default(0) @db.Decimal(12, 2)
  iva21          Decimal @default(0) @db.Decimal(12, 2)
  iva105         Decimal @default(0) @db.Decimal(12, 2)
  otrosImpuestos Decimal @default(0) @map("otros_impuestos") @db.Decimal(12, 2)
  montoTotal     Decimal @map("monto_total") @db.Decimal(12, 2)
  montoPagado    Decimal @default(0) @map("monto_pagado") @db.Decimal(12, 2)
  saldoPendiente Decimal @default(0) @map("saldo_pendiente") @db.Decimal(12, 2)

  // Datos de pago (cuando tipo = PAGO, RECIBO_COBRO, ORDEN_PAGO)
  cajaId       Int?    @map("caja_id")
  medioPago    String? @map("medio_pago") // EFECTIVO, TRANSFERENCIA, CHEQUE, TARJETA
  nroOperacion String? @map("nro_operacion")

  // Vinculacion con otros movimientos (ej: pago que cancela factura)
  movimientoPadreId Int? @map("movimiento_padre_id")

  // Clasificacion contable
  conceptoId    Int?     @map("concepto_id")
  centroCostoId Int?     @map("centro_costo_id")
  observaciones String?
  estado        String   @default("PENDIENTE") // PENDIENTE, PAGADO, ANULADO, CONFIRMADO
  registradoPor Int      @map("registrado_por")
  createdAt     DateTime @default(now()) @map("created_at")

  entidad          Entidad?             @relation(fields: [entidadId], references: [id])
  socio            Socio?               @relation(fields: [socioId], references: [id])
  ordenCompra      OrdenCompra?         @relation(fields: [ordenCompraId], references: [id])
  pedido           Pedido?              @relation(fields: [pedidoId], references: [id])
  caja             Caja?                @relation(fields: [cajaId], references: [id])
  concepto         ConceptoTesoreria?   @relation(fields: [conceptoId], references: [id])
  centroCosto      CentroCosto?         @relation(fields: [centroCostoId], references: [id])
  movimientoPadre  MovimientoContable?  @relation("MovimientoHijos", fields: [movimientoPadreId], references: [id])
  movimientosHijos MovimientoContable[] @relation("MovimientoHijos")
  items            ItemMovimiento[]
  movimientosCaja  MovimientoCaja[]
  movimientosStock MovimientoStock[]
  adjuntos         AdjuntoComprobante[]

  @@index([tipo])
  @@index([entidadId])
  @@index([socioId])
  @@index([ordenCompraId])
  @@index([pedidoId])
  @@index([centroCostoId])
  @@index([estado])
  @@index([fecha])
  @@map("movimientos_contables")
}

model ItemMovimiento {
  id                   Int     @id @default(autoincrement())
  movimientoContableId Int     @map("movimiento_contable_id")
  productoVarianteId   Int?    @map("producto_variante_id")
  itemOrdenCompraId    Int?    @map("item_orden_compra_id") // Vinculo a item de OC
  itemPedidoId         Int?    @map("item_pedido_id") // Vinculo a item de Pedido
  centroCostoId        Int?    @map("centro_costo_id") // Centro de costo del ítem
  descripcion          String?
  cantidad             Decimal @db.Decimal(12, 2)
  precioUnitario       Decimal @map("precio_unitario") @db.Decimal(12, 2)
  subtotal             Decimal @db.Decimal(12, 2)

  movimientoContable MovimientoContable @relation(fields: [movimientoContableId], references: [id], onDelete: Cascade)
  productoVariante   ProductoVariante?  @relation(fields: [productoVarianteId], references: [id])
  itemPedido         ItemPedido?        @relation(fields: [itemPedidoId], references: [id])
  centroCosto        CentroCosto?       @relation(fields: [centroCostoId], references: [id])

  @@index([movimientoContableId])
  @@index([productoVarianteId])
  @@index([centroCostoId])
  @@map("items_movimiento")
}

// =============================================================================
// MODULO LIQUIDACION DE SUELDOS
// =============================================================================

model ConceptoLiquidacion {
  id          Int      @id @default(autoincrement())
  codigo      String   @unique
  nombre      String
  tipo        String // HABER, DEDUCCION
  descripcion String?
  esFijo      Boolean  @default(false) @map("es_fijo") // Se aplica siempre a todos
  porcentaje  Decimal? @db.Decimal(5, 2) // Si es % del sueldo basico
  montoFijo   Decimal? @map("monto_fijo") @db.Decimal(12, 2)
  orden       Int      @default(0)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("conceptos_liquidacion")
}

model LiquidacionSueldo {
  id               Int       @id @default(autoincrement())
  numero           String    @unique // LIQ-2026-01
  periodo          String // "Enero 2026"
  mes              Int // 1-12
  anio             Int // 2026
  fechaGeneracion  DateTime  @default(now()) @map("fecha_generacion")
  fechaPago        DateTime? @map("fecha_pago")
  estado           String    @default("PENDIENTE") // PENDIENTE, PAGADO, PARCIAL, ANULADO
  totalBruto       Decimal   @default(0) @map("total_bruto") @db.Decimal(12, 2)
  totalDeducciones Decimal   @default(0) @map("total_deducciones") @db.Decimal(12, 2)
  totalNeto        Decimal   @default(0) @map("total_neto") @db.Decimal(12, 2)
  observaciones    String?
  registradoPor    Int       @map("registrado_por")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  items ItemLiquidacion[]

  @@unique([mes, anio])
  @@index([estado])
  @@map("liquidaciones_sueldo")
}

model ItemLiquidacion {
  id                   Int       @id @default(autoincrement())
  liquidacionId        Int       @map("liquidacion_id")
  entidadId            Int       @map("entidad_id") // Personal
  sueldoBasico         Decimal   @map("sueldo_basico") @db.Decimal(12, 2)
  totalHaberes         Decimal   @default(0) @map("total_haberes") @db.Decimal(12, 2)
  totalDeducciones     Decimal   @default(0) @map("total_deducciones") @db.Decimal(12, 2)
  netoAPagar           Decimal   @default(0) @map("neto_a_pagar") @db.Decimal(12, 2)
  detalleConceptos     Json?     @map("detalle_conceptos") // Array de {conceptoCodigo, conceptoNombre, tipo, monto, descripcion}
  estado               String    @default("PENDIENTE") // PENDIENTE, PAGADO
  fechaPago            DateTime? @map("fecha_pago")
  movimientoContableId Int?      @map("movimiento_contable_id") // Orden de pago asociada
  observaciones        String?
  createdAt            DateTime  @default(now()) @map("created_at")

  liquidacion LiquidacionSueldo @relation(fields: [liquidacionId], references: [id], onDelete: Cascade)
  entidad     Entidad           @relation(fields: [entidadId], references: [id])

  @@index([liquidacionId])
  @@index([entidadId])
  @@index([estado])
  @@map("items_liquidacion")
}

// =============================================================================
// MODULO GESTION DEPORTIVA
// =============================================================================

// Tipos de espacio (configurable)
model TipoEspacio {
  id          Int      @id @default(autoincrement())
  codigo      String   @unique
  nombre      String
  descripcion String?
  orden       Int      @default(0)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  espacios EspacioDeportivo[]

  @@map("tipos_espacio")
}

// Espacios físicos donde se realizan las actividades
model EspacioDeportivo {
  id            Int      @id @default(autoincrement())
  codigo        String   @unique
  nombre        String
  tipo          String? // DEPRECADO: migrar a tipoEspacioId
  tipoEspacioId Int?     @map("tipo_espacio_id")
  capacidad     Int?
  cubierto      Boolean  @default(false)
  iluminacion   Boolean  @default(true)
  descripcion   String?
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tipoEspacio            TipoEspacio?            @relation(fields: [tipoEspacioId], references: [id])
  actividades            Actividad[] // Qué actividades se pueden realizar
  horariosDisponibilidad HorarioDisponibilidad[]
  entrenamientos         Entrenamiento[]
  partidos               Partido[]

  @@map("espacios_deportivos")
}

// Horarios de disponibilidad de un espacio (días y horas)
model HorarioDisponibilidad {
  id                 Int      @id @default(autoincrement())
  espacioDeportivoId Int      @map("espacio_deportivo_id")
  diaSemana          Int      @map("dia_semana") // 0=Domingo, 1=Lunes, ..., 6=Sabado
  horaInicio         String   @map("hora_inicio") // "08:00"
  horaFin            String   @map("hora_fin") // "22:00"
  activo             Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at")

  espacioDeportivo EspacioDeportivo @relation(fields: [espacioDeportivoId], references: [id], onDelete: Cascade)

  @@unique([espacioDeportivoId, diaSemana])
  @@map("horarios_disponibilidad")
}

// Sesión de entrenamiento
model Entrenamiento {
  id                   Int      @id @default(autoincrement())
  categoriaActividadId Int      @map("categoria_actividad_id")
  espacioId            Int?     @map("espacio_id")
  fecha                DateTime @db.Date
  horaInicio           String   @map("hora_inicio") // "18:00"
  horaFin              String   @map("hora_fin") // "19:30"
  tipo                 String   @default("REGULAR") // REGULAR, ESPECIAL, RECUPERACION
  observaciones        String?
  estado               String   @default("PROGRAMADO") // PROGRAMADO, FINALIZADO, CANCELADO
  motivoCancelacion    String?  @map("motivo_cancelacion")
  registradoPor        Int      @map("registrado_por")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  categoriaActividad CategoriaActividad @relation(fields: [categoriaActividadId], references: [id])
  espacio            EspacioDeportivo?  @relation(fields: [espacioId], references: [id])
  asistencias        Asistencia[]

  @@index([categoriaActividadId])
  @@index([fecha])
  @@index([estado])
  @@map("entrenamientos")
}

// Horarios recurrentes (templates para generar entrenamientos)
model HorarioRecurrente {
  id                   Int      @id @default(autoincrement())
  categoriaActividadId Int      @map("categoria_actividad_id")
  espacioId            Int?     @map("espacio_id")
  diaSemana            Int      @map("dia_semana") // 1=Lunes, 2=Martes, ..., 7=Domingo
  horaInicio           String   @map("hora_inicio")
  horaFin              String   @map("hora_fin")
  activo               Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at")

  categoriaActividad CategoriaActividad @relation(fields: [categoriaActividadId], references: [id])

  @@index([categoriaActividadId])
  @@map("horarios_recurrentes")
}

// Asistencia a entrenamientos
model Asistencia {
  id              Int      @id @default(autoincrement())
  entrenamientoId Int      @map("entrenamiento_id")
  socioId         Int      @map("socio_id")
  estado          String // PRESENTE, AUSENTE, JUSTIFICADO, TARDE
  horaLlegada     String?  @map("hora_llegada")
  observaciones   String?
  registradoPor   Int      @map("registrado_por")
  createdAt       DateTime @default(now()) @map("created_at")

  entrenamiento Entrenamiento @relation(fields: [entrenamientoId], references: [id], onDelete: Cascade)
  socio         Socio         @relation(fields: [socioId], references: [id])

  @@unique([entrenamientoId, socioId])
  @@index([socioId])
  @@map("asistencias")
}

// Partidos/Eventos deportivos
model Partido {
  id                   Int      @id @default(autoincrement())
  categoriaActividadId Int      @map("categoria_actividad_id")
  fecha                DateTime @db.Date
  hora                 String
  tipo                 String   @default("LIGA") // LIGA, AMISTOSO, TORNEO, COPA
  condicion            String // LOCAL, VISITANTE
  rival                String
  ubicacion            String? // Dirección si es visitante
  espacioId            Int?     @map("espacio_id") // Si es local

  // Resultado
  golesLocal     Int? @map("goles_local")
  golesVisitante Int? @map("goles_visitante")

  estado        String   @default("PROGRAMADO") // PROGRAMADO, FINALIZADO, SUSPENDIDO, CANCELADO
  observaciones String?
  registradoPor Int      @map("registrado_por")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  categoriaActividad CategoriaActividad   @relation(fields: [categoriaActividadId], references: [id])
  espacio            EspacioDeportivo?    @relation(fields: [espacioId], references: [id])
  convocados         Convocatoria[]
  estadisticas       EstadisticaPartido[]

  @@index([categoriaActividadId])
  @@index([fecha])
  @@index([estado])
  @@map("partidos")
}

// Convocatoria a partido
model Convocatoria {
  id            Int      @id @default(autoincrement())
  partidoId     Int      @map("partido_id")
  socioId       Int      @map("socio_id")
  confirmado    Boolean? // null=pendiente, true=confirmado, false=rechazado
  motivoRechazo String?  @map("motivo_rechazo")

  // Tracking de notificaciones
  notificadoPush     Boolean?  @map("notificado_push")
  fechaNotifPush     DateTime? @map("fecha_notif_push")
  notificadoWhatsapp Boolean?  @map("notificado_whatsapp")
  fechaNotifWhatsapp DateTime? @map("fecha_notif_whatsapp")
  notificadoEmail    Boolean?  @map("notificado_email")
  fechaNotifEmail    DateTime? @map("fecha_notif_email")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  partido Partido @relation(fields: [partidoId], references: [id], onDelete: Cascade)
  socio   Socio   @relation(fields: [socioId], references: [id])

  @@unique([partidoId, socioId])
  @@index([socioId])
  @@map("convocatorias")
}

// Estadísticas individuales por partido
model EstadisticaPartido {
  id              Int     @id @default(autoincrement())
  partidoId       Int     @map("partido_id")
  socioId         Int     @map("socio_id")
  minutosJugados  Int?    @map("minutos_jugados")
  goles           Int     @default(0)
  asistencias     Int     @default(0)
  tarjetaAmarilla Int     @default(0) @map("tarjeta_amarilla")
  tarjetaRoja     Int     @default(0) @map("tarjeta_roja")
  esTitular       Boolean @default(false) @map("es_titular")

  partido Partido @relation(fields: [partidoId], references: [id], onDelete: Cascade)
  socio   Socio   @relation(fields: [socioId], references: [id])

  @@unique([partidoId, socioId])
  @@index([socioId])
  @@map("estadisticas_partidos")
}

// =============================================================================
// PRESUPUESTO ANUAL
// =============================================================================

model Presupuesto {
  id              Int       @id @default(autoincrement())
  anio            Int
  version         Int       @default(1) // Versión del presupuesto (1, 2, 3...)
  nombre          String? // Ej: "Presupuesto 2026 - Optimista"
  estado          String    @default("BORRADOR") // BORRADOR, APROBADO, CERRADO
  esPrincipal     Boolean   @default(false) @map("es_principal") // La versión activa/oficial
  observaciones   String?
  aprobadoPor     Int?      @map("aprobado_por")
  fechaAprobacion DateTime? @map("fecha_aprobacion")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  lineas LineaPresupuesto[]

  @@unique([anio, version])
  @@map("presupuestos")
}

model LineaPresupuesto {
  id                 Int      @id @default(autoincrement())
  presupuestoId      Int      @map("presupuesto_id")
  cuentaContableId   Int?     @map("cuenta_contable_id")
  conceptoId         Int?     @map("concepto_id")
  mes                Int // 1-12
  montoPresupuestado Decimal  @map("monto_presupuestado") @db.Decimal(12, 2)
  observaciones      String?
  createdAt          DateTime @default(now()) @map("created_at")

  presupuesto    Presupuesto        @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)
  cuentaContable CuentaContable?    @relation(fields: [cuentaContableId], references: [id])
  concepto       ConceptoTesoreria? @relation(fields: [conceptoId], references: [id])

  @@unique([presupuestoId, cuentaContableId, conceptoId, mes])
  @@index([presupuestoId])
  @@index([cuentaContableId])
  @@index([conceptoId])
  @@map("lineas_presupuesto")
}

// Centro de Costo - Para análisis multidimensional por área/actividad
model CentroCosto {
  id          Int      @id @default(autoincrement())
  codigo      String   @unique
  nombre      String
  descripcion String?
  tipo        String   @default("OPERATIVO") // OPERATIVO, ADMINISTRATIVO
  activo      Boolean  @default(true)
  orden       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relaciones
  actividades          Actividad[]
  movimientosCaja      MovimientoCaja[]
  movimientosContables MovimientoContable[]
  asientoLineas        AsientoLinea[]
  itemsMovimiento      ItemMovimiento[]

  @@map("centros_costo")
}

// Pagos informados por socios (transferencias pendientes de confirmación)
model PagoInformado {
  id                  Int       @id @default(autoincrement())
  socioId             Int       @map("socio_id")
  cuotasIds           String    @map("cuotas_ids") // JSON array de IDs de cuotas
  monto               Decimal   @db.Decimal(12, 2)
  metodoPago          String    @map("metodo_pago") // TRANSFERENCIA, MERCADOPAGO, MODO
  comprobante         String? // URL del comprobante subido
  comprobanteOriginal String?   @map("comprobante_original") // Nombre original del archivo
  observaciones       String?
  estado              String    @default("PENDIENTE") // PENDIENTE, CONFIRMADO, RECHAZADO
  fechaInformado      DateTime  @default(now()) @map("fecha_informado")
  fechaProcesado      DateTime? @map("fecha_procesado")
  procesadoPor        Int?      @map("procesado_por")
  motivoRechazo       String?   @map("motivo_rechazo")
  pagoId              Int?      @map("pago_id") // ID del pago una vez confirmado
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  socio Socio  @relation(fields: [socioId], references: [id])
  admin Admin? @relation(fields: [procesadoPor], references: [id])

  @@index([socioId])
  @@index([estado])
  @@index([fechaInformado])
  @@map("pagos_informados")
}

// ============================================
// SISTEMA DE NOTIFICACIONES Y TEMPLATES
// ============================================

model EmailTemplate {
  id          String   @id @default(cuid())
  eventType   String   @unique // COMPROBANTE_PAGO, PAGO_CONFIRMADO, PAGO_RECHAZADO, RECORDATORIO_VENCIMIENTO, CUOTA_GENERADA
  nombre      String
  descripcion String?
  subject     String   // Asunto con variables Handlebars {{variable}}
  bodyHtml    String   @db.Text // HTML del email con variables
  bodyText    String?  @db.Text // Versión texto plano
  variables   String   @default("[]") @db.Text // JSON array con lista de variables disponibles
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("email_templates")
}

model PdfTemplate {
  id          String   @id @default(cuid())
  tipo        String   @unique // RECIBO, FACTURA, COMPROBANTE_PAGO
  nombre      String
  descripcion String?
  htmlContent String   @db.Text // HTML completo del PDF con variables Handlebars
  cssContent  String   @db.Text // CSS inline para Puppeteer
  variables   String   @default("[]") @db.Text // JSON array con lista de variables disponibles
  pageFormat  String   @default("A4") // A4, Letter, etc.
  orientation String   @default("portrait") // portrait, landscape
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("pdf_templates")
}

// Log de notificaciones enviadas o programadas
model NotificacionLog {
  id           Int       @id @default(autoincrement())
  tipo         String    // EMAIL, SMS, WHATSAPP, PUSH
  eventType    String    // CUOTA_PROX_VENCER, CUOTA_VENCIDA, MOROSIDAD, INSCRIPCION_CONFIRMADA, BIENVENIDA, NOTICIA
  destinatario String    // Email, teléfono o device token
  socioId      Int?      @map("socio_id")
  cargoId      Int?      @map("cargo_id") // Referencia a la cuota si aplica
  asunto       String?   // Asunto del email
  cuerpo       String?   @db.Text // Cuerpo del mensaje
  enviado      Boolean   @default(false)
  fechaEnvio   DateTime? @map("fecha_envio")
  fechaProgramado DateTime? @map("fecha_programado") // Cuándo se debe enviar
  intentos     Int       @default(0) // Número de intentos de envío
  error        String?   @db.Text // Mensaje de error si falló
  metadata     String?   @db.Text // JSON con info adicional
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  socio        Socio?    @relation(fields: [socioId], references: [id])
  cargo        Cargo?    @relation(fields: [cargoId], references: [id])

  @@index([socioId])
  @@index([cargoId])
  @@index([eventType])
  @@index([enviado])
  @@index([fechaProgramado])
  @@map("notificaciones_log")
}

// Solicitudes de alta de nuevos socios desde formulario público
model SolicitudSocio {
  id                      Int       @id @default(autoincrement())
  // Datos del solicitante
  apellidos               String
  nombres                 String
  documento               String
  fechaNacimiento         DateTime  @map("fecha_nacimiento")
  direccionCalle          String    @map("direccion_calle")
  direccionNumero         String    @map("direccion_numero")
  localidad               String
  telefono                String
  email                   String
  actividadesSeleccionadas String   @default("[]") @map("actividades_seleccionadas") @db.Text // JSON array: ["Basquet", "Futbol 11"]

  // Datos de salud
  tieneEnfermedades       Boolean   @default(false) @map("tiene_enfermedades")
  detalleEnfermedades     String?   @db.Text @map("detalle_enfermedades")

  // Datos del tutor (si es menor)
  tutorApellidos          String?   @map("tutor_apellidos")
  tutorNombres            String?   @map("tutor_nombres")
  tutorDocumento          String?   @map("tutor_documento")
  tutorTelefono           String?   @map("tutor_telefono")

  // Estado de la solicitud
  estado                  String    @default("PENDIENTE") // PENDIENTE, APROBADA, RECHAZADA
  motivoRechazo           String?   @db.Text @map("motivo_rechazo")

  // Auditoría
  fechaSolicitud          DateTime  @default(now()) @map("fecha_solicitud")
  fechaRespuesta          DateTime? @map("fecha_respuesta")
  respondidoPor           Int?      @map("respondido_por") // ID del admin que procesó
  socioCreado             Int?      @map("socio_creado") // ID del socio creado al aprobar
  observacionesInternas   String?   @db.Text @map("observaciones_internas")

  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  socioCreatedRel         Socio?              @relation(fields: [socioCreado], references: [id])
  respondidoPorAdmin      Admin?              @relation(fields: [respondidoPor], references: [id])
  familiares              FamiliarSolicitud[]

  @@index([estado])
  @@index([fechaSolicitud])
  @@index([documento])
  @@index([email])
  @@map("solicitudes_socio")
}

// Familiares agregados a una solicitud de socio (antes de aprobar)
model FamiliarSolicitud {
  id                      Int            @id @default(autoincrement())
  solicitudSocioId        Int            @map("solicitud_socio_id")
  apellidos               String
  nombres                 String
  documento               String
  fechaNacimiento         DateTime       @map("fecha_nacimiento")
  parentesco              String         // CONYUGE, HIJO
  actividadesSeleccionadas String        @default("[]") @map("actividades_seleccionadas") // JSON array ["Basquet", "Futbol 11"]
  socioCreado             Int?           @map("socio_creado") // ID del socio creado al aprobar
  createdAt               DateTime       @default(now()) @map("created_at")
  updatedAt               DateTime       @updatedAt @map("updated_at")

  solicitud               SolicitudSocio @relation(fields: [solicitudSocioId], references: [id], onDelete: Cascade)
  socioCreatedRel         Socio?         @relation("FamiliarSolicitudSocio", fields: [socioCreado], references: [id])

  @@index([solicitudSocioId])
  @@index([documento])
  @@map("familiares_solicitud")
}

// Cierre de caja diario - Control de efectivo y arqueo
model CierreCaja {
  id                     Int       @id @default(autoincrement())
  cajaId                 Int       @map("caja_id")
  fecha                  DateTime  @default(now()) // Fecha del cierre (día que se está cerrando)

  // Saldos y diferencias
  saldoSistema           Decimal   @map("saldo_sistema") @db.Decimal(12, 2)  // Saldo según sistema
  saldoReal              Decimal   @map("saldo_real") @db.Decimal(12, 2)     // Saldo real contado
  diferencia             Decimal   @map("diferencia") @db.Decimal(12, 2)     // Diferencia (puede ser + o -)

  // Resumen de movimientos del día
  totalIngresos          Decimal   @map("total_ingresos") @db.Decimal(12, 2)
  totalEgresos           Decimal   @map("total_egresos") @db.Decimal(12, 2)
  cantidadMovimientos    Int       @map("cantidad_movimientos")

  // Observaciones y notas
  observaciones          String?   @db.Text

  // Auditoría
  cerradoPor             Int       @map("cerrado_por")      // Admin que hizo el cierre
  firmadoPor             Int?      @map("firmado_por")      // Admin que firmó/aprobó
  fechaCierre            DateTime  @default(now()) @map("fecha_cierre")
  fechaFirma             DateTime? @map("fecha_firma")

  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  // Relaciones
  caja                   Caja      @relation(fields: [cajaId], references: [id])
  adminCerrado           Admin     @relation("CierreCajaCerradoPor", fields: [cerradoPor], references: [id])
  adminFirmado           Admin?    @relation("CierreCajaFirmadoPor", fields: [firmadoPor], references: [id])

  @@index([cajaId])
  @@index([fecha])
  @@index([cerradoPor])
  @@map("cierres_caja")
}

// Push Subscriptions para notificaciones web push
model PushSubscription {
  id        Int      @id @default(autoincrement())
  socioId   Int      @map("socio_id")
  endpoint  String   @unique @db.Text
  p256dh    String   @db.Text
  auth      String
  userAgent String?  @map("user_agent") @db.Text
  activa    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  socio     Socio    @relation(fields: [socioId], references: [id], onDelete: Cascade)

  @@index([socioId])
  @@index([activa])
  @@map("push_subscriptions")
}

// =============================================================================
// MODULO PUBLICIDAD Y SPONSORS
// =============================================================================

// Sponsors/Auspiciantes - Empresas que contratan publicidad
model Sponsor {
  id              Int       @id @default(autoincrement())
  nombre          String
  razonSocial     String?   @map("razon_social")
  cuit            String?
  contactoNombre  String?   @map("contacto_nombre")
  contactoEmail   String?   @map("contacto_email")
  contactoTelefono String?  @map("contacto_telefono")
  direccion       String?
  logo            String?   // URL del logo
  sitioWeb        String?   @map("sitio_web")
  observaciones   String?   @db.Text
  activo          Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  banners         Banner[]

  @@index([activo])
  @@map("sponsors")
}

// Banners publicitarios
model Banner {
  id              Int       @id @default(autoincrement())
  titulo          String                      // Nombre interno para identificar
  sponsorId       Int?      @map("sponsor_id") // Sponsor asociado (opcional)
  tipo            String    @default("LATERAL") // HERO, LATERAL, FOOTER, POPUP
  ubicaciones     String[]  @default([])       // Páginas donde mostrar: HOME, ACTIVIDADES, NOTICIAS, etc. Vacío = TODAS
  imagenDesktop   String    @map("imagen_desktop") // Imagen para desktop
  imagenMobile    String?   @map("imagen_mobile")  // Imagen opcional para móvil
  linkDestino     String?   @map("link_destino")   // URL al hacer clic
  textoAlt        String?   @map("texto_alt")      // Texto alternativo para accesibilidad
  orden           Int       @default(0)        // Orden de aparición
  activo          Boolean   @default(true)
  // Programación
  fechaInicio     DateTime? @map("fecha_inicio")
  fechaFin        DateTime? @map("fecha_fin")
  // Métricas
  impresiones     Int       @default(0)        // Veces mostrado
  clics           Int       @default(0)        // Veces clickeado
  // Contrato/Facturación
  montoMensual    Decimal?  @map("monto_mensual") @db.Decimal(12, 2)
  mesContratado   String?   @map("mes_contratado") // "2026-02" formato YYYY-MM
  pagado          Boolean   @default(false)
  // Auditoría
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  sponsor         Sponsor?  @relation(fields: [sponsorId], references: [id])

  @@index([tipo])
  @@index([activo])
  @@index([fechaInicio, fechaFin])
  @@map("banners")
}

// =============================================================================
// MODULO NOTICIAS / BLOG
// =============================================================================

model Noticia {
  id               Int       @id @default(autoincrement())
  titulo           String
  slug             String    @unique              // URL amigable
  extracto         String?   @db.Text             // Resumen corto
  contenido        String    @db.Text             // Contenido completo (HTML)
  imagen           String?                        // URL imagen principal
  categoria        String    @default("INSTITUCIONAL") // INSTITUCIONAL, DEPORTES, ACTIVIDADES, EVENTOS
  destacada        Boolean   @default(false)      // Mostrar en home
  publicada        Boolean   @default(false)      // Solo visible si está publicada
  fechaPublicacion DateTime? @map("fecha_publicacion")
  autorId          Int?      @map("autor_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  autor            Admin?    @relation(fields: [autorId], references: [id])

  @@index([publicada])
  @@index([categoria])
  @@index([fechaPublicacion])
  @@index([destacada])
  @@map("noticias")
}

// Autoridades del club - editable desde admin
model Autoridad {
  id          Int      @id @default(autoincrement())
  seccion     String   // COMISION_DIRECTIVA, VOCALES, REVISORES, SUBCOMISIONES
  cargo       String?  // Para Comisión: Presidente, Vicepresidente, etc.
  nombre      String   // Nombre completo de la persona o nombre de subcomisión
  tipo        String?  // Para Vocales/Revisores: TITULAR, SUPLENTE
  desde       String?  // Año desde (ej: "2024")
  email       String?
  telefono    String?
  foto        String?  // URL de la foto
  descripcion String?  @db.Text // Para subcomisiones: descripción
  responsable String?  // Para subcomisiones: nombre del responsable
  orden       Int      @default(0)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([seccion])
  @@index([activo])
  @@map("autoridades")
}

// =============================================================================
// MODULO MENSAJERÍA - Chat Socio/Entrenador
// =============================================================================

// Conversación entre un socio y un entrenador de una categoría específica
model Conversacion {
  id                   Int                @id @default(autoincrement())
  socioId              Int                @map("socio_id")
  entrenadorId         Int                @map("entrenador_id")
  categoriaActividadId Int?               @map("categoria_actividad_id")
  asunto               String?            // Asunto opcional de la conversación
  estado               String             @default("ACTIVA") // ACTIVA, ARCHIVADA, CERRADA
  ultimoMensaje        DateTime?          @map("ultimo_mensaje")
  mensajesNoLeidos     Int                @default(0) @map("mensajes_no_leidos")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  socio                Socio              @relation(fields: [socioId], references: [id], onDelete: Cascade)
  entrenador           Entrenador         @relation(fields: [entrenadorId], references: [id], onDelete: Cascade)
  categoriaActividad   CategoriaActividad? @relation(fields: [categoriaActividadId], references: [id])
  mensajes             Mensaje[]

  @@unique([socioId, entrenadorId, categoriaActividadId])
  @@index([socioId])
  @@index([entrenadorId])
  @@index([estado])
  @@index([ultimoMensaje])
  @@map("conversaciones")
}

// Mensaje dentro de una conversación
model Mensaje {
  id              Int          @id @default(autoincrement())
  conversacionId  Int          @map("conversacion_id")
  emisorTipo      String       @map("emisor_tipo") // SOCIO, ENTRENADOR
  emisorId        Int          @map("emisor_id")   // ID del socio o entrenador
  contenido       String       @db.Text
  leido           Boolean      @default(false)
  fechaLeido      DateTime?    @map("fecha_leido")
  createdAt       DateTime     @default(now()) @map("created_at")

  conversacion    Conversacion @relation(fields: [conversacionId], references: [id], onDelete: Cascade)

  @@index([conversacionId])
  @@index([leido])
  @@index([createdAt])
  @@map("mensajes")
}

// =============================================================================
// MODULO BUFFET / RESTAURANT
// =============================================================================

// Mesa del buffet/restaurant
model Mesa {
  id              Int       @id @default(autoincrement())
  numero          Int       @unique
  nombre          String?   // "Mesa 1", "Barra", etc.
  capacidad       Int       @default(4)
  estado          String    @default("LIBRE") // LIBRE, OCUPADA, CUENTA_PEDIDA, LIMPIEZA
  zona            String?   // SALON, TERRAZA, BARRA
  esComunal       Boolean   @default(false) @map("es_comunal") // Permite múltiples comandas simultáneas
  mozoAsignadoId  Int?      @map("mozo_asignado_id") // Mozo responsable de esta mesa
  activo          Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  mozoAsignado Admin?    @relation("MesasAsignadas", fields: [mozoAsignadoId], references: [id])
  comandas     Comanda[]

  @@index([estado])
  @@index([activo])
  @@index([mozoAsignadoId])
  @@map("mesas")
}

// Categoría del menú (BEBIDAS, COMIDAS, POSTRES, etc.)
model CategoriaMenu {
  id                Int                 @id @default(autoincrement())
  codigo            String              @unique
  nombre            String
  descripcion       String?
  color             String?             // Color para UI
  icono             String?             // Icono lucide
  orden             Int                 @default(0)
  activo            Boolean             @default(true)
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  productos         ProductoBuffet[]
  destinosImpresion DestinoImpresion[]

  @@map("categorias_menu")
}

// Producto específico del buffet (referencia a Producto del stock)
model ProductoBuffet {
  id               Int              @id @default(autoincrement())
  productoId       Int              @map("producto_id")
  categoriaMenuId  Int              @map("categoria_menu_id")
  nombre           String           // Nombre para mostrar en el menú
  descripcion      String?
  codigoBarras     String?          @map("codigo_barras") // Para escaneo en kiosco
  precio           Decimal          @db.Decimal(12, 2)
  imagen           String?          // URL de la imagen
  tiposVenta       String[]         @default(["BUFFET", "KIOSCO"]) @map("tipos_venta") // BUFFET, KIOSCO o ambos
  disponible       Boolean          @default(true)
  destacado        Boolean          @default(false)
  orden            Int              @default(0)
  activo           Boolean          @default(true)
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  producto         Producto      @relation(fields: [productoId], references: [id])
  categoriaMenu    CategoriaMenu @relation(fields: [categoriaMenuId], references: [id])
  itemsComanda     ItemComanda[]
  itemsTakeAway    ItemPedidoTakeAway[]

  @@unique([productoId])
  @@index([categoriaMenuId])
  @@index([disponible])
  @@index([activo])
  @@index([tiposVenta])
  @@index([codigoBarras])
  @@map("productos_buffet")
}

// Comanda de una mesa
model Comanda {
  id              Int            @id @default(autoincrement())
  numero          String         @unique
  mesaId          Int            @map("mesa_id")
  socioId         Int?           @map("socio_id") // Si es socio identificado
  estado          String         @default("ABIERTA") // ABIERTA, EN_PREPARACION, CUENTA_PEDIDA, CERRADA, ANULADA
  horaApertura    DateTime       @default(now()) @map("hora_apertura")
  horaCierre      DateTime?      @map("hora_cierre")
  subtotal        Decimal        @default(0) @db.Decimal(12, 2)
  descuento       Decimal        @default(0) @db.Decimal(12, 2)
  total           Decimal        @default(0) @db.Decimal(12, 2)
  observaciones   String?
  atendidoPor     Int?           @map("atendido_por") // Admin/mozo que atendió
  cerradoPor      Int?           @map("cerrado_por")  // Admin que cerró/cobró
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  mesa            Mesa           @relation(fields: [mesaId], references: [id])
  socio           Socio?         @relation(fields: [socioId], references: [id])
  atendedor       Admin?         @relation("ComandaAtendedor", fields: [atendidoPor], references: [id])
  cerrador        Admin?         @relation("ComandaCerrador", fields: [cerradoPor], references: [id])
  items           ItemComanda[]
  movimientosCaja MovimientoCaja[]

  @@index([mesaId])
  @@index([socioId])
  @@index([estado])
  @@index([horaApertura])
  @@map("comandas")
}

// Item de una comanda
model ItemComanda {
  id               Int            @id @default(autoincrement())
  comandaId        Int            @map("comanda_id")
  productoBuffetId Int            @map("producto_buffet_id")
  cantidad         Int            @default(1)
  precioUnitario   Decimal        @db.Decimal(12, 2)
  subtotal         Decimal        @db.Decimal(12, 2)
  estado           String         @default("PENDIENTE") // PENDIENTE, ENVIADO_COCINA, EN_PREPARACION, LISTO, ENTREGADO, ANULADO
  observaciones    String?        // "Sin sal", "Bien cocido", etc.
  enviadoCocinaAt  DateTime?      @map("enviado_cocina_at")
  listoAt          DateTime?      @map("listo_at")
  entregadoAt      DateTime?      @map("entregado_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  comanda          Comanda        @relation(fields: [comandaId], references: [id], onDelete: Cascade)
  productoBuffet   ProductoBuffet @relation(fields: [productoBuffetId], references: [id])

  @@index([comandaId])
  @@index([estado])
  @@map("items_comanda")
}

// Pedido Take Away
model PedidoTakeAway {
  id              Int                  @id @default(autoincrement())
  numero          String               @unique
  nombreCliente   String               @map("nombre_cliente")
  telefono        String?
  socioId         Int?                 @map("socio_id") // Si es socio identificado
  estado          String               @default("RECIBIDO") // RECIBIDO, EN_PREPARACION, LISTO, ENTREGADO, CANCELADO
  horaRecibido    DateTime             @default(now()) @map("hora_recibido")
  horaEstimada    DateTime?            @map("hora_estimada")
  horaListo       DateTime?            @map("hora_listo")
  horaEntregado   DateTime?            @map("hora_entregado")
  subtotal        Decimal              @default(0) @db.Decimal(12, 2)
  descuento       Decimal              @default(0) @db.Decimal(12, 2)
  total           Decimal              @default(0) @db.Decimal(12, 2)
  observaciones   String?
  atendidoPor     Int?                 @map("atendido_por")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  socio           Socio?               @relation(fields: [socioId], references: [id])
  atendedor       Admin?               @relation(fields: [atendidoPor], references: [id])
  items           ItemPedidoTakeAway[]
  movimientosCaja MovimientoCaja[]

  @@index([socioId])
  @@index([estado])
  @@index([horaRecibido])
  @@map("pedidos_takeaway")
}

// Item de un pedido Take Away
model ItemPedidoTakeAway {
  id               Int            @id @default(autoincrement())
  pedidoId         Int            @map("pedido_id")
  productoBuffetId Int            @map("producto_buffet_id")
  cantidad         Int            @default(1)
  precioUnitario   Decimal        @db.Decimal(12, 2)
  subtotal         Decimal        @db.Decimal(12, 2)
  estado           String         @default("PENDIENTE") // PENDIENTE, EN_PREPARACION, LISTO
  observaciones    String?
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  pedido           PedidoTakeAway @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  productoBuffet   ProductoBuffet @relation(fields: [productoBuffetId], references: [id])

  @@index([pedidoId])
  @@index([estado])
  @@map("items_pedido_takeaway")
}

// Impresora térmica para tickets
// Sector de preparación del Buffet (Cocina, Barra, Parrilla, etc.)
model SectorBuffet {
  id          Int                @id @default(autoincrement())
  codigo      String             @unique
  nombre      String
  icono       String?            // Nombre del icono lucide (ChefHat, Coffee, Flame, etc.)
  color       String             @default("#DC2626") // Color hex para UI
  orden       Int                @default(0)
  activo      Boolean            @default(true)
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  impresoras  ImpresoraTermica[]

  @@map("sectores_buffet")
}

model ImpresoraTermica {
  id                Int                @id @default(autoincrement())
  nombre            String             @unique
  sectorId          Int?               @map("sector_id")
  ip                String
  puerto            Int                @default(9100)
  activo            Boolean            @default(true)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  sector            SectorBuffet?      @relation(fields: [sectorId], references: [id])
  destinosImpresion DestinoImpresion[]

  @@map("impresoras_termicas")
}

// Mapeo: qué categoría imprime en qué impresora
model DestinoImpresion {
  id              Int              @id @default(autoincrement())
  categoriaMenuId Int              @map("categoria_menu_id")
  impresoraId     Int              @map("impresora_id")
  createdAt       DateTime         @default(now()) @map("created_at")

  categoriaMenu   CategoriaMenu    @relation(fields: [categoriaMenuId], references: [id], onDelete: Cascade)
  impresora       ImpresoraTermica @relation(fields: [impresoraId], references: [id], onDelete: Cascade)

  @@unique([categoriaMenuId, impresoraId])
  @@map("destinos_impresion")
}

// Notificaciones en tiempo real del buffet
model NotificacionBuffet {
  id            Int       @id @default(autoincrement())
  tipo          String    // NUEVA_COMANDA, ITEM_LISTO, CUENTA_PEDIDA, MESA_COBRADA
  titulo        String
  mensaje       String
  datos         Json?     // { mesaId, comandaId, itemIds, total, etc }
  sonido        String    @default("default") // default, bell, chime, alert
  paraUsuarioId Int?      @map("para_usuario_id") // Si es para un usuario específico
  paraDestino   String?   @map("para_destino") // COCINA, BARRA, CAJA (tipo de impresora)
  createdAt     DateTime  @default(now()) @map("created_at")

  paraUsuario   Admin?    @relation("NotificacionesRecibidas", fields: [paraUsuarioId], references: [id])
  vistas        NotificacionVista[]

  @@index([paraUsuarioId])
  @@index([paraDestino])
  @@index([createdAt])
  @@map("notificaciones_buffet")
}

model NotificacionVista {
  notificacionId Int      @map("notificacion_id")
  adminId        Int      @map("admin_id")
  vistaAt        DateTime @default(now()) @map("vista_at")

  notificacion   NotificacionBuffet @relation(fields: [notificacionId], references: [id], onDelete: Cascade)
  admin          Admin              @relation("NotificacionesVistas", fields: [adminId], references: [id])

  @@id([notificacionId, adminId])
  @@map("notificaciones_vistas")
}

// =============================================================================
// ADJUNTOS DE COMPROBANTES
// =============================================================================

model AdjuntoComprobante {
  id                   Int       @id @default(autoincrement())

  // Referencias opcionales (solo una tendrá valor)
  movimientoContableId Int?      @map("movimiento_contable_id")
  movimientoCajaId     Int?      @map("movimiento_caja_id")
  ordenCompraId        Int?      @map("orden_compra_id")
  pedidoId             Int?      @map("pedido_id")
  asientoId            Int?      @map("asiento_id")
  pagoId               Int?      @map("pago_id")

  // Datos del archivo
  nombreOriginal       String    @map("nombre_original")
  nombreArchivo        String    @map("nombre_archivo") // UUID.ext almacenado en disco
  rutaArchivo          String    @map("ruta_archivo")
  tipoMime             String    @map("tipo_mime")
  tamanio              Int       // bytes

  // Auditoría
  subidoPor            Int       @map("subido_por")
  createdAt            DateTime  @default(now()) @map("created_at")

  // Relaciones
  movimientoContable   MovimientoContable? @relation(fields: [movimientoContableId], references: [id], onDelete: Cascade)
  movimientoCaja       MovimientoCaja?     @relation(fields: [movimientoCajaId], references: [id], onDelete: Cascade)
  ordenCompra          OrdenCompra?        @relation(fields: [ordenCompraId], references: [id], onDelete: Cascade)
  pedido               Pedido?             @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  asiento              Asiento?            @relation(fields: [asientoId], references: [id], onDelete: Cascade)
  pago                 Pago?               @relation(fields: [pagoId], references: [id], onDelete: Cascade)
  admin                Admin               @relation(fields: [subidoPor], references: [id])

  @@index([movimientoContableId])
  @@index([movimientoCajaId])
  @@index([ordenCompraId])
  @@index([pedidoId])
  @@index([asientoId])
  @@index([pagoId])
  @@map("adjuntos_comprobantes")
}
