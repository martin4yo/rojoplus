// ============================================
// CONTROL DE ACCESOS
// ============================================

model DispositivoAcceso {
  id                Int                     @id @default(autoincrement())
  codigo            String
  nombre            String
  ubicacion         String
  ipLocal           String?                 @map("ip_local")
  puerto            Int                     @default(3002)
  puertoSerialRFID  String?                 @map("puerto_serial_rfid")
  tipoRelay         String                  @default("GPIO") @map("tipo_relay")
  pinRelay          Int?                    @map("pin_relay")
  tiempoApertura    Int                     @default(3) @map("tiempo_apertura")
  modoOffline       Boolean                 @default(true) @map("modo_offline")
  intervaloSync     Int                     @default(5) @map("intervalo_sync")
  activo            Boolean                 @default(true)
  apiToken          String?                 @unique @map("api_token")
  ultimoPing        DateTime?               @map("ultimo_ping")
  version           String?
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")
  registros         RegistroAcceso[]
  intentosDenegados IntentoAccesoDenegado[]
