// ==============================
// EVENTOS Y ENTRADAS
// ==============================

model Evento {
  id                  Int                  @id @default(autoincrement())
  codigo              String              
  nombre              String
  descripcion         String?              @db.Text
  tipo                String               // DEPORTIVO, SOCIAL, RECREATIVO
  fecha               DateTime             @db.Date
  hora                String
  horaApertura        String?              @map("hora_apertura")
  horaFin             String?              @map("hora_fin")
  estado              String               @default("PROGRAMADO") @map("estado") // PROGRAMADO, EN_CURSO, FINALIZADO, CANCELADO
  espacioId           Int?                 @map("espacio_id")
  ubicacion           String?
  capacidadTotal      Int                  @map("capacidad_total")
  entradasVendidas    Int                  @default(0) @map("entradas_vendidas")
  entradasIngresadas  Int                  @default(0) @map("entradas_ingresadas")
  permiteSobreventa   Boolean              @default(false) @map("permite_sobreventa")
  ventasHabilitadas   Boolean              @default(true) @map("ventas_habilitadas")
  partidoId           Int?                 @unique @map("partido_id")
  imagen              String?
  conceptoTesoreriaId Int?                 @map("concepto_tesoreria_id")
  centroCostoId       Int?                 @map("centro_costo_id")
  creadoPor           Int                  @map("creado_por")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  centroCosto         CentroCosto?         @relation(fields: [centroCostoId], references: [id])
  conceptoTesoreria   ConceptoTesoreria?   @relation(fields: [conceptoTesoreriaId], references: [id])
  espacio             EspacioDeportivo?    @relation(fields: [espacioId], references: [id])
  partido             Partido?             @relation(fields: [partidoId], references: [id])
  creador             Admin                @relation("EventoCreador", fields: [creadoPor], references: [id])
  categorias          CategoriaEntrada[]
  entradas            Entrada[]
  ingresos            IngresoEntrada[]

  tenantId    Int      @map("tenant_id")
  @@index([tipo])
  @@index([fecha])
  @@index([estado])
  @@index([partidoId])
  @@index([espacioId])
  @@index([conceptoTesoreriaId])
  @@index([centroCostoId])
  @@index([tenantId])
  @@unique([tenantId, codigo])
  @@map("eventos")
}

model CategoriaEntrada {
  id                Int        @id @default(autoincrement())
  eventoId          Int        @map("evento_id")
  nombre            String
  descripcion       String?
  precioSocio       Decimal    @map("precio_socio") @db.Decimal(10, 2)
  precioNoSocio     Decimal    @map("precio_no_socio") @db.Decimal(10, 2)
  capacidad         Int?
  entradasVendidas  Int        @default(0) @map("entradas_vendidas")
  activo            Boolean    @default(true)
  orden             Int        @default(0)
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  evento            Evento     @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  entradas          Entrada[]

  tenantId    Int      @map("tenant_id")
  @@index([eventoId])
  @@index([activo])
  @@index([tenantId])
  @@map("categorias_entrada")
}

model Entrada {
  id                  Int                @id @default(autoincrement())
  codigo              String             @default(uuid())
  eventoId            Int                @map("evento_id")
  categoriaId         Int                @map("categoria_id")
  socioId             Int?               @map("socio_id")
  nombreComprador     String             @map("nombre_comprador")
  documentoComprador  String?            @map("documento_comprador")
  emailComprador      String?            @map("email_comprador")
  celularComprador    String?            @map("celular_comprador")
  precio              Decimal            @db.Decimal(10, 2)
  esSocio             Boolean            @map("es_socio")
  estado              String             @default("VALIDA") // VALIDA, USADA, ANULADA
  fechaVenta          DateTime           @default(now()) @map("fecha_venta")
  fechaAnulacion      DateTime?          @map("fecha_anulacion")
  motivoAnulacion     String?            @map("motivo_anulacion")
  canalVenta          String             @map("canal_venta") // ADMIN, PORTAL_SOCIO, SITIO_WEB, BUFFET
  vendidoPor          Int?               @map("vendido_por")
  movimientoCajaId    Int?               @map("movimiento_caja_id")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  evento              Evento             @relation(fields: [eventoId], references: [id])
  categoria           CategoriaEntrada   @relation(fields: [categoriaId], references: [id])
  socio               Socio?             @relation(fields: [socioId], references: [id])
  movimientoCaja      MovimientoCaja?    @relation(fields: [movimientoCajaId], references: [id])
  vendedor            Admin?             @relation("EntradaVendedor", fields: [vendidoPor], references: [id])
  ingreso             IngresoEntrada?

  tenantId    Int      @map("tenant_id")
  @@index([eventoId])
  @@index([socioId])
  @@index([estado])
  @@index([codigo])
  @@index([categoriaId])
  @@index([fechaVenta])
  @@index([movimientoCajaId])
  @@index([tenantId])
  @@unique([tenantId, codigo])
  @@map("entradas")
}

model IngresoEntrada {
  id              Int                 @id @default(autoincrement())
  entradaId       Int                 @unique @map("entrada_id")
  eventoId        Int                 @map("evento_id")
  fecha           DateTime            @default(now())
  dispositivoId   Int?                @map("dispositivo_id")
  validadoPor     Int?                @map("validado_por")
  modoValidacion  String              @default("QR") @map("modo_validacion") // QR, MANUAL_PWA
  createdAt       DateTime            @default(now()) @map("created_at")
  entrada         Entrada             @relation(fields: [entradaId], references: [id])
  evento          Evento              @relation(fields: [eventoId], references: [id])
  dispositivo     DispositivoAcceso?  @relation(fields: [dispositivoId], references: [id])
  validador       Admin?              @relation("IngresoValidador", fields: [validadoPor], references: [id])

  tenantId    Int      @map("tenant_id")
  @@index([eventoId])
  @@index([fecha])
  @@index([dispositivoId])
  @@index([tenantId])
  @@map("ingresos_entradas")
}

// ==============================
