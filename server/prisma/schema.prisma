  incluidoEnDebitoId   Int?                @map("incluido_en_debito_id")
  observaciones        String?
  loteId               String?             @map("lote_id")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  categoria            String              @default("CUOTA_SOCIAL")
  tipoCuota            String?             @map("tipo_cuota")
  conceptoTesoreriaId  Int?                @map("concepto_tesoreria_id")
  cargoOrigen          Cargo?              @relation("CargosDerivados", fields: [cargoOrigenId], references: [id])
  cargosDerivados      Cargo[]             @relation("CargosDerivados")
  categoriaActividad   CategoriaActividad? @relation(fields: [categoriaActividadId], references: [id])
  centroCosto          CentroCosto?        @relation(fields: [centroCostoId], references: [id])
  conceptoTesoreria    ConceptoTesoreria?  @relation(fields: [conceptoTesoreriaId], references: [id])
  archivoDebito        ArchivoDebito?      @relation(fields: [incluidoEnDebitoId], references: [id])
  pago                 Pago?               @relation(fields: [pagoId], references: [id])
  periodo              Periodo?            @relation(fields: [periodoId], references: [id])
  socio                Socio?              @relation(fields: [socioId], references: [id])
