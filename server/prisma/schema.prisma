  updatedAt        DateTime           @updatedAt @map("updated_at")
  categoria        CategoriaProducto? @relation(fields: [categoriaId], references: [id])
  conceptoCompra   ConceptoTesoreria? @relation("ProductoConceptoCompra", fields: [conceptoCompraId], references: [id])
  conceptoVenta    ConceptoTesoreria? @relation("ProductoConceptoVenta", fields: [conceptoVentaId], references: [id])
  variantes        ProductoVariante[]
  fotos            ProductoFoto[]

  @@index([categoriaId])
  @@index([conceptoCompraId])
  @@index([conceptoVentaId])
  @@map("productos")
}

model ProductoVariante {
  id               Int               @id @default(autoincrement())
  productoId       Int               @map("producto_id")
  talle            String
  color            String?
  sku              String?           @unique
  stockActual      Decimal           @default(0) @map("stock_actual") @db.Decimal(12, 2)
  stockMinimo      Decimal           @default(0) @map("stock_minimo") @db.Decimal(12, 2)
  activo           Boolean           @default(true)
  createdAt        DateTime          @default(now()) @map("created_at")
  producto         Producto          @relation(fields: [productoId], references: [id], onDelete: Cascade)
  movimientos      MovimientoStock[]
  itemsOrdenCompra ItemOrdenCompra[]

  @@unique([productoId, talle, color])
  @@index([productoId])
  @@map("producto_variantes")
}

model ProductoFoto {
  id          Int      @id @default(autoincrement())
  productoId  Int      @map("producto_id")
  url         String
  orden       Int      @default(0)
  esPrincipal Boolean  @default(false) @map("es_principal")
  createdAt   DateTime @default(now()) @map("created_at")
  producto    Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  @@index([productoId])
  @@map("producto_fotos")
}

model MovimientoStock {
  id                 Int              @id @default(autoincrement())
  productoVarianteId Int              @map("producto_variante_id")
  fecha              DateTime         @default(now())
  tipo               String
  cantidad           Decimal          @db.Decimal(12, 2)
  stockAnterior      Decimal          @map("stock_anterior") @db.Decimal(12, 2)
  stockPosterior     Decimal          @map("stock_posterior") @db.Decimal(12, 2)
  concepto           String?
  registradoPor      Int              @map("registrado_por")
  createdAt          DateTime         @default(now()) @map("created_at")
  productoVariante   ProductoVariante @relation(fields: [productoVarianteId], references: [id])

  @@index([productoVarianteId])
  @@index([fecha])
  @@map("movimientos_stock")
}
