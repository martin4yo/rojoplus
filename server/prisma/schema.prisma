// Sistema de Opciones/Modificadores de Productos
// Permite configurar combos con opciones (ej: Milanesa + Guarnición, Desayuno + Infusión)
// y productos armables (ej: Ensalada personalizada)

model GrupoOpcionProducto {
  id                Int               @id @default(autoincrement())
  productoBuffetId  Int               @map("producto_buffet_id")
  nombre            String            // Ej: "Guarnición", "Infusión", "Ingredientes"
  descripcion       String?
  tipo              String            @default("UNICA") // UNICA = seleccionar 1, MULTIPLE = seleccionar varios
  obligatorio       Boolean           @default(true)
  minSelecciones    Int               @default(1) @map("min_selecciones") // Mínimo de opciones a seleccionar
  maxSelecciones    Int               @default(1) @map("max_selecciones") // Máximo de opciones a seleccionar
  orden             Int               @default(0)
  activo            Boolean           @default(true)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  productoBuffet    ProductoBuffet    @relation(fields: [productoBuffetId], references: [id], onDelete: Cascade)
  opciones          OpcionProducto[]

  tenantId    Int      @map("tenant_id")
  @@index([productoBuffetId])
  @@index([tenantId])
  @@map("grupos_opcion_producto")
}

model OpcionProducto {
  id                      Int                   @id @default(autoincrement())
  grupoId                 Int                   @map("grupo_id")
  nombre                  String                // Ej: "Papas Fritas", "Café" - Puede ser null si usa productoRef
  descripcion             String?
  precioAdicional         Decimal               @default(0) @map("precio_adicional") @db.Decimal(12, 2) // Precio extra/descuento
  productoRefId           Int?                  @map("producto_ref_id") // Referencia opcional a ProductoBuffet (ej: empanada individual)
  seleccionadoPorDefecto  Boolean               @default(false) @map("seleccionado_por_defecto") // true = viene incluido (hamburguesa), false = debe agregarse (ensalada)
  disponible              Boolean               @default(true)
  orden                   Int                   @default(0)
  activo                  Boolean               @default(true)
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")
  grupo                   GrupoOpcionProducto   @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  productoRef             ProductoBuffet?       @relation("ProductoComoOpcion", fields: [productoRefId], references: [id])
  opcionesComanda         OpcionItemComanda[]
  opcionesTakeAway        OpcionItemTakeAway[]

  tenantId    Int      @map("tenant_id")
  @@index([grupoId])
  @@index([productoRefId])
  @@index([tenantId])
  @@map("opciones_producto")
}

model Comanda {
  id              Int              @id @default(autoincrement())
  numero          String          
  mesaId          Int              @map("mesa_id")
  socioId         Int?             @map("socio_id")
  centroCostoId   Int?             @map("centro_costo_id")
  estado          String           @default("ABIERTA")
  horaApertura    DateTime         @default(now()) @map("hora_apertura")
  horaCierre      DateTime?        @map("hora_cierre")
  subtotal        Decimal          @default(0) @db.Decimal(12, 2)
  descuento       Decimal          @default(0) @db.Decimal(12, 2)
  propina         Decimal          @default(0) @db.Decimal(12, 2)
  total           Decimal          @default(0) @db.Decimal(12, 2)
  observaciones   String?
  atendidoPor     Int?             @map("atendido_por")
  cerradoPor      Int?             @map("cerrado_por")
  esVentaInterna  Boolean          @default(false) @map("es_venta_interna")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  atendedor       Admin?           @relation("ComandaAtendedor", fields: [atendidoPor], references: [id])
  centroCosto     CentroCosto?     @relation(fields: [centroCostoId], references: [id])
  cerrador        Admin?           @relation("ComandaCerrador", fields: [cerradoPor], references: [id])
  mesa            Mesa             @relation(fields: [mesaId], references: [id])
  socio           Socio?           @relation(fields: [socioId], references: [id])
  items           ItemComanda[]
  movimientosCaja MovimientoCaja[]
  comprobantes    ComprobanteElectronico[]

  tenantId    Int      @map("tenant_id")
  @@index([mesaId])
  @@index([socioId])
  @@index([estado])
  @@index([horaApertura])
  @@index([centroCostoId])
  @@index([tenantId])
  @@unique([tenantId, numero])
  @@map("comandas")
}

