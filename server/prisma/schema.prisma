generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ConceptoTesoreria - Conceptos para movimientos de caja (cuota social, actividades, etc)
model ConceptoTesoreria {
  id                   Int                  @id @default(autoincrement())
  codigo               String               @unique
  nombre               String
  descripcion          String?
  tipo                 String               @default("INGRESO") // INGRESO, EGRESO, AMBOS
  usaEnTesoreria       Boolean              @default(true) @map("usa_en_tesoreria")
  usaEnCompras         Boolean              @default(false) @map("usa_en_compras")
  usaEnVentas          Boolean              @default(false) @map("usa_en_ventas")
  cuentaContableId     Int?                 @map("cuenta_contable_id")
  activo               Boolean              @default(true)
  orden                Int                  @default(0)
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  cuentaContable       CuentaContable?      @relation(fields: [cuentaContableId], references: [id])
  tiposSocio           TipoSocio[]          @relation("TipoSocioConcepto")
  tiposSocioMora       TipoSocio[]          @relation("TipoSocioConceptoMora")
  actividades          Actividad[]          @relation("ActividadConcepto")
  actividadesMora      Actividad[]          @relation("ActividadConceptoMora")
  categoriasActividad  CategoriaActividad[]
  productosCompra      Producto[]           @relation("ProductoConceptoCompra")
  productosVenta       Producto[]           @relation("ProductoConceptoVenta")
  movimientosContables MovimientoContable[]
  lineasPresupuesto    LineaPresupuesto[]

  @@map("conceptos_tesoreria")
}

model TipoSocio {
  id                  Int                @id @default(autoincrement())
  codigo              String             @unique
  nombre              String
  descripcion         String?
  cuotaMensual        Decimal?           @map("cuota_mensual") @db.Decimal(12, 2)
  conceptoTesoreriaId Int?               @map("concepto_tesoreria_id")
  conceptoMoraId      Int?               @map("concepto_mora_id")
  color               String?
  orden               Int                @default(0)
  activo              Boolean            @default(true)
  createdAt           DateTime           @default(now()) @map("created_at")
  socios              Socio[]
  conceptoTesoreria   ConceptoTesoreria? @relation("TipoSocioConcepto", fields: [conceptoTesoreriaId], references: [id])
  conceptoMora        ConceptoTesoreria? @relation("TipoSocioConceptoMora", fields: [conceptoMoraId], references: [id])

  @@map("tipos_socio")
}

model CategoriaSocio {
  id                  Int      @id @default(autoincrement())
  codigo              String   @unique
  nombre              String
  descripcion         String?
  porcentajeDescuento Decimal  @default(0) @map("porcentaje_descuento") @db.Decimal(5, 2)
  color               String?
  orden               Int      @default(0)
  activo              Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at")
  socios              Socio[]

  @@map("categorias_socio")
}

model EstadoSocio {
  id                Int      @id @default(autoincrement())
  codigo            String   @unique
  nombre            String
  descripcion       String?
  color             String?
  permiteDescuentos Boolean  @default(false) @map("permite_descuentos")
  orden             Int      @default(0)
  activo            Boolean  @default(true)
  createdAt         DateTime @default(now()) @map("created_at")
  socios            Socio[]

  @@map("estados_socio")
}

model Socio {
  id                    Int                  @id @default(autoincrement())
  nroSocio              String               @unique @map("nro_socio")
  documento             String?
  apellidoNombre        String               @map("apellido_nombre")
  estado                String               @default("ACTIVO")
  email                 String?
  celular               String?
  fechaNacimiento       DateTime?            @map("fecha_nacimiento")
  categoria             String?
  tipoSocio             String?              @map("tipo_socio")
  domicilio             String?
  ciudad                String?
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")
  tokenPortal           String?              @unique @default(uuid()) @map("token_portal")
  tokenPortalExpira     DateTime?            @map("token_portal_expira")
  actualizadoPor        Int?                 @map("actualizado_por")
  alergias              String?
  aliasDebito           String?              @map("alias_debito")
  antiguedadEstatutaria Int?                 @map("antiguedad_estatutaria")
  apellido              String?
  aptaFisicaVence       DateTime?            @map("apta_fisica_vence")
  aptaFisicaVigente     Boolean              @default(false) @map("apta_fisica_vigente")
  bancoDebito           String?              @map("banco_debito")
  barrio                String?
  calle                 String?
  cbuDebito             String?              @map("cbu_debito")
  celularSecundario     String?              @map("celular_secundario")
  cobradorId            Int?                 @map("cobrador_id")
  codigoPostal          String?              @map("codigo_postal")
  condicionFiscal       String?              @map("condicion_fiscal")
  condicionesMedicas    String?              @map("condiciones_medicas")
  creadoPor             Int?                 @map("creado_por")
  cuil                  String?
  debitoTipo            String?              @map("debito_tipo")
  debitoVerificado      Boolean              @default(false) @map("debito_verificado")
  depto                 String?
  emailSecundario       String?              @map("email_secundario")
  emergenciaNombre1     String?              @map("emergencia_nombre_1")
  emergenciaNombre2     String?              @map("emergencia_nombre_2")
  emergenciaParent1     String?              @map("emergencia_parentesco_1")
  emergenciaParent2     String?              @map("emergencia_parentesco_2")
  emergenciaTel1        String?              @map("emergencia_tel_1")
  emergenciaTel2        String?              @map("emergencia_tel_2")
  enviaDebito           Boolean              @default(false) @map("envia_debito")
  esMenor               Boolean              @default(false) @map("es_menor")
  estadoCivil           String?              @map("estado_civil")
  factorRh              String?              @map("factor_rh")
  fechaAlta             DateTime?            @map("fecha_alta")
  fechaBaja             DateTime?            @map("fecha_baja")
  folio                 String?
  formaPagoPref         String?              @map("forma_pago_pref")
  fotoUrl               String?              @map("foto_url")
  grupoSanguineo        String?              @map("grupo_sanguineo")
  libro                 String?
  lugarNacimiento       String?              @map("lugar_nacimiento")
  medicamentos          String?
  motivoBaja            String?              @map("motivo_baja")
  nacionalidad          String?              @default("Argentina")
  nombre                String?
  nroObraSocial         String?              @map("nro_obra_social")
  numero                String?
  obraSocial            String?              @map("obra_social")
  observaciones         String?
  observacionesInternas String?              @map("observaciones_internas")
  parentescoResponsable String?              @map("parentesco_responsable")
  parentescoTitular     String?              @map("parentesco_titular")
  piso                  String?
  profesion             String?
  provincia             String?              @default("Buenos Aires")
  responsableId         Int?                 @map("responsable_id")
  sexo                  String?
  tarjetaCvv            String?              @map("tarjeta_cvv")
  tarjetaMarca          String?              @map("tarjeta_marca")
  tarjetaNumero         String?              @map("tarjeta_numero")
  tarjetaToken          String?              @map("tarjeta_token")
  tarjetaTokenizador    String?              @map("tarjeta_tokenizador")
  tarjetaUltimos4       String?              @map("tarjeta_ultimos_4")
  tarjetaVencimiento    String?              @map("tarjeta_vencimiento")
  telefonoFijo          String?              @map("telefono_fijo")
  tipoDocumento         String               @default("DNI") @map("tipo_documento")
  titularCuenta         String?              @map("titular_cuenta")
  zona                  String?
  categoriaSocioId      Int?                 @map("categoria_socio_id")
  estadoSocioId         Int?                 @map("estado_socio_id")
  tipoSocioRelId        Int?                 @map("tipo_socio_rel_id")
  titularFamiliaId      Int?                 @map("titular_familia_id")
  // Preferencias de notificaciones - Cuotas y General
  notificarCuotaProxVenc Boolean             @default(true) @map("notificar_cuota_prox_venc") // Email 5 días antes
  notificarCuotaVencida  Boolean             @default(true) @map("notificar_cuota_vencida") // Email día vencimiento
  notificarMorosidad     Boolean             @default(true) @map("notificar_morosidad") // Email cada 15 días
  notificarInscripcion   Boolean             @default(true) @map("notificar_inscripcion") // Confirmación de inscripción
  notificarNoticias      Boolean             @default(true) @map("notificar_noticias") // Noticias del club
  notificarPush          Boolean             @default(true) @map("notificar_push") // Notificaciones push
  // Preferencias de notificaciones - Deportivas
  notificarConvocatoria      Boolean         @default(true) @map("notificar_convocatoria") // Convocatoria a partidos
  notificarRecordatorioPartido Boolean       @default(true) @map("notificar_recordatorio_partido") // Recordatorio 24h antes
  notificarCancelacionEntreno Boolean        @default(true) @map("notificar_cancelacion_entreno") // Cancelación de entrenamiento
  notificarNuevoEntrenamiento Boolean        @default(true) @map("notificar_nuevo_entrenamiento") // Nuevo entrenamiento programado
  autorizaciones        AutorizacionMenor[]
  cargos                Cargo[]
  detallesCobranza      DetalleCobranza[]
  documentos            DocumentoSocio[]
  detallesDebito        DetalleDebito[]
  inscripciones         Inscripcion[]
  linksPago             LinkPago[]
  pagos                 Pago[]
  saldosFavor           SaldoFavor[]
  categoriaSocioRel     CategoriaSocio?      @relation(fields: [categoriaSocioId], references: [id])
  cobrador              Cobrador?            @relation(fields: [cobradorId], references: [id])
  estadoSocioRel        EstadoSocio?         @relation(fields: [estadoSocioId], references: [id])
  responsable           Socio?               @relation("ResponsableMenor", fields: [responsableId], references: [id])
  menoresACargo         Socio[]              @relation("ResponsableMenor")
  tipoSocioRel          TipoSocio?           @relation(fields: [tipoSocioRelId], references: [id])
  titularFamilia        Socio?               @relation("MiembrosFamilia", fields: [titularFamiliaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  miembrosFamilia       Socio[]              @relation("MiembrosFamilia")
  ventas                Venta[]
  movimientosContables  MovimientoContable[]
  pedidos               Pedido[]
  echeqs                ECheq[]
  asistencias           Asistencia[]
  convocatorias         Convocatoria[]
  comandas              Comanda[]
  pedidosTakeAway       PedidoTakeAway[]
  estadisticasPartido   EstadisticaPartido[]
  pagosInformados       PagoInformado[]
  notificaciones        NotificacionLog[]
  solicitudesAprobadas  SolicitudSocio[]
  familiarSolicitud     FamiliarSolicitud[] @relation("FamiliarSolicitudSocio")
  pushSubscriptions     PushSubscription[]
  conversaciones        Conversacion[]

  @@index([documento])
  @@index([apellidoNombre])
  @@index([estado])
  @@index([estadoSocioId])
  @@index([categoriaSocioId])
  @@index([tipoSocioRelId])
  @@index([responsableId])
  @@index([cobradorId])
  @@index([zona])
  @@index([titularFamiliaId], map: "idx_socios_titular_familia_id")
  @@map("socios")
}

// Documentos del socio (aptos fisicos, estudios, certificados, etc.)
model DocumentoSocio {
  id               Int       @id @default(autoincrement())
  socioId          Int       @map("socio_id")
  tipo             String // APTO_FISICO, CERTIFICADO_ESTUDIOS, DNI, FICHA_MEDICA, OTRO
  nombre           String
  descripcion      String?
  archivoUrl       String    @map("archivo_url")
  archivoNombre    String    @map("archivo_nombre")
  archivoTipo      String?   @map("archivo_tipo") // mime type
  archivoSize      Int?      @map("archivo_size") // bytes
  fechaEmision     DateTime? @map("fecha_emision")
  fechaVencimiento DateTime? @map("fecha_vencimiento")
  vigente          Boolean   @default(true)
  observaciones    String?
  creadoPor        Int?      @map("creado_por")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  socio            Socio     @relation(fields: [socioId], references: [id])

  @@index([socioId])
  @@index([tipo])
  @@index([fechaVencimiento])
  @@map("documentos_socio")
}

model AutorizacionMenor {
  id                Int       @id @default(autoincrement())
  socioId           Int       @map("socio_id")
  tipo              String
  descripcion       String
  otorgadaPor       String    @map("otorgada_por")
  dniOtorgante      String?   @map("dni_otorgante")
  fechaOtorgamiento DateTime  @map("fecha_otorgamiento")
  fechaVencimiento  DateTime? @map("fecha_vencimiento")
  documentoUrl      String?   @map("documento_url")
  activa            Boolean   @default(true)
  createdAt         DateTime  @default(now()) @map("created_at")
  socio             Socio     @relation(fields: [socioId], references: [id])

  @@map("autorizaciones_menores")
}

model Cobrador {
  id          Int      @id @default(autoincrement())
  codigo      String   @unique
  nombre      String
  telefono    String?
  email       String?
  zonas       String?
  comisionPct Decimal  @default(0) @map("comision_pct") @db.Decimal(5, 2)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  pagos       Pago[]
  socios      Socio[]

  @@map("cobradores")
}

// Actividad (padre) - ej: BASQUET, FUTBOL, TENIS
model Actividad {
  id                  Int                  @id @default(autoincrement())
  codigo              String               @unique
  nombre              String
  descripcion         String?
  requiereAptaFisica  Boolean              @default(true) @map("requiere_apta_fisica")
  cuotaMensual        Decimal?             @map("cuota_mensual") @db.Decimal(12, 2)
  conceptoTesoreriaId Int?                 @map("concepto_tesoreria_id")
  conceptoMoraId      Int?                 @map("concepto_mora_id")
  centroCostoId       Int?                 @map("centro_costo_id")
  color               String?
  activo              Boolean              @default(true)
  orden               Int                  @default(0)
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  categorias          CategoriaActividad[]
  conceptoTesoreria   ConceptoTesoreria?   @relation("ActividadConcepto", fields: [conceptoTesoreriaId], references: [id])
  conceptoMora        ConceptoTesoreria?   @relation("ActividadConceptoMora", fields: [conceptoMoraId], references: [id])
  centroCosto         CentroCosto?         @relation(fields: [centroCostoId], references: [id])
  espacios            EspacioDeportivo[]

  @@map("actividades")
}

// CategoriaActividad (hija) - ej: BASQUET CADETE, BASQUET PRE MINI
model CategoriaActividad {
  id                   Int                   @id @default(autoincrement())
  actividadId          Int                   @map("actividad_id")
  codigo               String                @unique
  nombre               String
  descripcion          String?
  edadMinima           Int?                  @map("edad_minima")
  edadMaxima           Int?                  @map("edad_maxima")
  sexo                 String?
  cuotaMensual         Decimal?              @map("cuota_mensual") @db.Decimal(12, 2)
  conceptoTesoreriaId  Int?                  @map("concepto_tesoreria_id")
  diasEntrenamiento    String?               @map("dias_entrenamiento")
  horarioEntrenamiento String?               @map("horario_entrenamiento")
  lugarEntrenamiento   String?               @map("lugar_entrenamiento")
  cupoMaximo           Int?                  @map("cupo_maximo")
  activo               Boolean               @default(true)
  orden                Int                   @default(0)
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  actividad            Actividad             @relation(fields: [actividadId], references: [id])
  inscripciones        Inscripcion[]
  entrenadores         EntrenadorCategoria[]
  cargos               Cargo[]
  conceptoTesoreria    ConceptoTesoreria?    @relation(fields: [conceptoTesoreriaId], references: [id])
  entrenamientos       Entrenamiento[]
  horariosRecurrentes  HorarioRecurrente[]
  partidos             Partido[]
  conversaciones       Conversacion[]

  @@index([actividadId])
  @@map("categorias_actividad")
}

model Inscripcion {
  id                   Int                @id @default(autoincrement())
  socioId              Int                @map("socio_id")
  categoriaActividadId Int                @map("categoria_actividad_id")
  fechaInscripcion     DateTime           @default(now()) @map("fecha_inscripcion")
  fechaInicio          DateTime           @map("fecha_inicio")
  fechaFin             DateTime?          @map("fecha_fin")
  motivoFin            String?            @map("motivo_fin")
  exentoCuota          Boolean            @default(false) @map("exento_cuota")
  motivoExencion       String?            @map("motivo_exencion")
  becado               Boolean            @default(false)
  federado             Boolean            @default(false)
  porcentajeCuota      Decimal            @default(100) @map("porcentaje_cuota") @db.Decimal(5, 2)
  autorizadoPor        String?            @map("autorizado_por")
  fechaAutorizacion    DateTime?          @map("fecha_autorizacion")
  estado               String             @default("ACTIVA")
  observaciones        String?
  exceptuadoPasaje     Boolean            @default(false) @map("exceptuado_pasaje")
  motivoExcepcion      String?            @map("motivo_excepcion_pasaje")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  categoriaActividad   CategoriaActividad @relation(fields: [categoriaActividadId], references: [id])
  socio                Socio              @relation(fields: [socioId], references: [id])

  @@unique([socioId, categoriaActividadId, fechaInicio])
  @@index([socioId])
  @@index([categoriaActividadId])
  @@index([estado])
  @@map("inscripciones")
}

// Entrenador (tabla principal)
model Entrenador {
  id            Int                   @id @default(autoincrement())
  nombre        String
  apellido      String?
  documento     String?
  telefono      String?
  email         String?
  socioId       Int?                  @map("socio_id")
  entidadId     Int?                  @unique @map("entidad_id")
  especialidad  String?
  observaciones String?
  activo        Boolean               @default(true)
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")
  categorias      EntrenadorCategoria[]
  entidad         Entidad?              @relation(fields: [entidadId], references: [id])
  conversaciones  Conversacion[]

  @@map("entrenadores")
}

// Relacion Entrenador-Categoria (muchos a muchos)
model EntrenadorCategoria {
  id                   Int                @id @default(autoincrement())
  entrenadorId         Int                @map("entrenador_id")
  categoriaActividadId Int                @map("categoria_actividad_id")
  rol                  String             @default("ENTRENADOR") // ENTRENADOR, ASISTENTE, PREPARADOR_FISICO
  fechaDesde           DateTime           @default(now()) @map("fecha_desde")
  fechaHasta           DateTime?          @map("fecha_hasta")
  activo               Boolean            @default(true)
  createdAt            DateTime           @default(now()) @map("created_at")
  entrenador           Entrenador         @relation(fields: [entrenadorId], references: [id])
  categoriaActividad   CategoriaActividad @relation(fields: [categoriaActividadId], references: [id])

  @@unique([entrenadorId, categoriaActividadId])
  @@map("entrenadores_categorias")
}

model ConfiguracionRecargo {
  id         Int      @id @default(autoincrement())
  tipo       String   @default("FIJO") // FIJO o ACUMULATIVO
  porcentaje Decimal  @db.Decimal(5, 2) // Porcentaje a aplicar
  cadaDias   Int?     @map("cada_dias") // Solo para ACUMULATIVO: cada cuántos días
  topeMaximo Decimal? @map("tope_maximo") @db.Decimal(5, 2) // Tope máximo para ACUMULATIVO
  activo     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("configuracion_recargos")
}

model Periodo {
  id               Int       @id @default(autoincrement())
  anio             Int
  mes              Int
  nombre           String
  fechaGeneracion  DateTime? @map("fecha_generacion")
  fechaVencimiento DateTime  @map("fecha_vencimiento")
  estado           String    @default("PENDIENTE")
  generadoPor      Int?      @map("generado_por")
  createdAt        DateTime  @default(now()) @map("created_at")
  cargos           Cargo[]

  @@unique([anio, mes])
  @@map("periodos")
}

// Cargo - Modelo unificado para todos los cargos al socio/grupo familiar
// Categorías: CUOTA_SOCIAL, CUOTA_ACTIVIDAD, CARNET, MOROSIDAD, NOTA_CREDITO, FINANCIACION
model Cargo {
  id                   Int                 @id @default(autoincrement())
  periodoId            Int?                @map("periodo_id") // Nullable para cargos únicos sin periodo
  socioId              Int?                @map("socio_id")
  grupoFamiliarId      Int?                @map("grupo_familiar_id")
  categoria            String              @default("CUOTA_SOCIAL") // CUOTA_SOCIAL, CUOTA_ACTIVIDAD, CARNET, MOROSIDAD, NOTA_CREDITO, FINANCIACION
  tipoCuota            String?             @map("tipo_cuota") // GRUPO_FAMILIAR, SOCIO_UNICO (solo para CUOTA_SOCIAL)
  categoriaActividadId Int?                @map("categoria_actividad_id") // Solo para categoria=CUOTA_ACTIVIDAD
  descripcion          String? // Descripción del cargo
  montoOriginal        Decimal             @map("monto_original") @db.Decimal(12, 2)
  montoRecargo         Decimal             @default(0) @map("monto_recargo") @db.Decimal(12, 2)
  montoBonificacion    Decimal             @default(0) @map("monto_bonificacion") @db.Decimal(12, 2)
  montoTotal           Decimal             @map("monto_total") @db.Decimal(12, 2)
  estado               String              @default("PENDIENTE") // PENDIENTE, PAGADO, ANULADO
  fechaGeneracion      DateTime            @default(now()) @map("fecha_generacion")
  fechaVencimiento     DateTime?           @map("fecha_vencimiento")
  fechaPago            DateTime?           @map("fecha_pago")
  pagoId               Int?                @map("pago_id")
  cargoOrigenId        Int?                @map("cargo_origen_id") // Para MOROSIDAD/NOTA_CREDITO/FINANCIACION
  origen               String              @default("MANUAL") // GENERACION_MASIVA, MANUAL, MOROSIDAD, FINANCIACION
  motivoBonificacion   String?             @map("motivo_bonificacion")
  incluidoEnDebitoId   Int?                @map("incluido_en_debito_id")
  observaciones        String?
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  categoriaActividad   CategoriaActividad? @relation(fields: [categoriaActividadId], references: [id])
  archivoDebito        ArchivoDebito?      @relation(fields: [incluidoEnDebitoId], references: [id])
  pago                 Pago?               @relation(fields: [pagoId], references: [id])
  periodo              Periodo?            @relation(fields: [periodoId], references: [id])
  socio                Socio?              @relation(fields: [socioId], references: [id])
  cargoOrigen          Cargo?              @relation("CargosDerivados", fields: [cargoOrigenId], references: [id])
  cargosDerivados      Cargo[]             @relation("CargosDerivados")
  notificaciones       NotificacionLog[]

  @@index([periodoId])
  @@index([socioId])
  @@index([grupoFamiliarId])
  @@index([categoria])
  @@index([estado])
  @@index([fechaVencimiento])
  @@index([cargoOrigenId])
  @@map("cargos")
}

