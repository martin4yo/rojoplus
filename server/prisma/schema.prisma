// =============================================================================
// MODULO ENTIDADES (Proveedores, Clientes, Personal)
// =============================================================================

// Tabla de cargos para Personal (configurable)
model CargoPersonal {
  id          Int       @id @default(autoincrement())
  codigo      String    @unique
  nombre      String
  descripcion String?
  activo      Boolean   @default(true)
  orden       Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")

  entidades   Entidad[]

  @@map("cargos_personal")
}

model Entidad {
  id              Int             @id @default(autoincrement())
  codigo          String          @unique
  tipo            String          // PROVEEDOR, CLIENTE, PERSONAL
  razonSocial     String          @map("razon_social")
  nombreFantasia  String?         @map("nombre_fantasia")
  tipoDocumento   String          @default("CUIT") @map("tipo_documento")
  documento       String?
  email           String?
  telefono        String?
  direccion       String?
  ciudad          String?
  provincia       String?
  codigoPostal    String?         @map("codigo_postal")
  condicionIva    String?         @map("condicion_iva")
  // Datos bancarios
  banco           String?
  cbu             String?
  alias           String?
  // Solo PERSONAL
  legajo          String?
  cargoPersonalId Int?            @map("cargo_personal_id")
  fechaIngreso    DateTime?       @map("fecha_ingreso")
  sueldoBasico    Decimal?        @map("sueldo_basico") @db.Decimal(12, 2)
  // Común
  observaciones   String?
  activo          Boolean         @default(true)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  cargoPersonal   CargoPersonal?  @relation(fields: [cargoPersonalId], references: [id])
  ordenesCompra   OrdenCompra[]
  entrenador      Entrenador?

  @@index([tipo])
  @@index([documento])
  @@index([cargoPersonalId])
  @@map("entidades")
}

// =============================================================================
// MODULO ORDENES DE COMPRA
// =============================================================================

model OrdenCompra {
  id              Int               @id @default(autoincrement())
  numero          String            @unique
  entidadId       Int               @map("entidad_id")
  fecha           DateTime          @default(now())
  fechaEntrega    DateTime?         @map("fecha_entrega")
  estado          String            @default("PENDIENTE") // PENDIENTE, PARCIAL, RECIBIDA, CANCELADA
  subtotal        Decimal           @default(0) @db.Decimal(12, 2)
  iva             Decimal           @default(0) @db.Decimal(12, 2)
  total           Decimal           @default(0) @db.Decimal(12, 2)
  observaciones   String?
  registradoPor   Int               @map("registrado_por")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  entidad         Entidad           @relation(fields: [entidadId], references: [id])
  items           ItemOrdenCompra[]

  @@index([entidadId])
  @@index([estado])
  @@index([fecha])
  @@map("ordenes_compra")
}

model ItemOrdenCompra {
  id                 Int              @id @default(autoincrement())
  ordenCompraId      Int              @map("orden_compra_id")
  productoVarianteId Int?             @map("producto_variante_id")
  descripcion        String?
  cantidad           Decimal          @db.Decimal(12, 2)
  cantidadRecibida   Decimal          @default(0) @map("cantidad_recibida") @db.Decimal(12, 2)
  precioUnitario     Decimal          @map("precio_unitario") @db.Decimal(12, 2)
  subtotal           Decimal          @db.Decimal(12, 2)

  ordenCompra        OrdenCompra      @relation(fields: [ordenCompraId], references: [id], onDelete: Cascade)
  productoVariante   ProductoVariante? @relation(fields: [productoVarianteId], references: [id])

  @@index([ordenCompraId])
  @@map("items_orden_compra")
}

