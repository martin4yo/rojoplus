// ============================================================================
// eCheqs (Cheques Electrónicos)
// ============================================================================
// Los eCheqs son VALORES PENDIENTES que NO afectan el saldo de caja hasta
// que se concretan (ACREDITADO para recibidos, DEBITADO para emitidos).
//
// EMITIDO: Cheque que el club emite a un proveedor
//   - cajaOrigenId: Banco del club de donde se va a debitar
//   - Flujo: PENDIENTE → DEBITADO (afecta saldo) o ANULADO
//   - Al pasar a DEBITADO: se crea MovimientoCaja EGRESO y baja el saldo
//
// RECIBIDO: Cheque que el club recibe de un cliente/socio
//   - cajaDestinoId: Banco del club donde se va a depositar/acreditar
//   - Flujo: CARTERA → DEPOSITADO → ACREDITADO (afecta saldo)
//           CARTERA → ENDOSADO (no afecta saldo, se transfiere)
//           CARTERA/DEPOSITADO → RECHAZADO
//   - Al pasar a ACREDITADO: se crea MovimientoCaja INGRESO y sube el saldo
// ============================================================================
model ECheq {
  id      Int     @id @default(autoincrement())
  numero  String  @unique
  tipo    String // EMITIDO, RECIBIDO
  cmc7    String? // Código CMC7 del cheque
  echeqId String? @map("echeq_id") // ID del eCheq en el sistema bancario

  // Datos del cheque
  monto            Decimal  @db.Decimal(12, 2)
  fechaEmision     DateTime @map("fecha_emision")
  fechaVencimiento DateTime @map("fecha_vencimiento")

  // Datos del emisor del cheque
  // Si EMITIDO: datos del club (se completan automáticamente)
  // Si RECIBIDO: datos del tercero que entrega el cheque
  bancoEmisor  String  @map("banco_emisor")
  cuentaOrigen String? @map("cuenta_origen")
  cuitEmisor   String? @map("cuit_emisor")
  nombreEmisor String? @map("nombre_emisor")

  // Beneficiario/Origen según tipo
  entidadId Int? @map("entidad_id") // EMITIDO: Proveedor beneficiario / RECIBIDO: Cliente que lo entrega
  socioId   Int? @map("socio_id") // RECIBIDO: Socio que lo entrega (alternativo a entidadId)

  // Caja/Banco del club que se afectará
  // EMITIDO: Banco del club de donde se DEBITARÁ el monto
  // RECIBIDO: Banco del club donde se ACREDITARÁ el monto (se asigna al depositar)
  cajaOrigenId  Int? @map("caja_origen_id") // Solo EMITIDO: banco de donde sale
  cajaDestinoId Int? @map("caja_destino_id") // Solo RECIBIDO: banco donde se deposita

  // Estado del cheque
  // EMITIDO:  PENDIENTE → DEBITADO | ANULADO | RECHAZADO
  // RECIBIDO: CARTERA → DEPOSITADO → ACREDITADO | ENDOSADO | RECHAZADO | ANULADO
  estado String @default("PENDIENTE")

  // Fechas de operación
  fechaDeposito     DateTime? @map("fecha_deposito") // RECIBIDO: cuando se depositó
  fechaAcreditacion DateTime? @map("fecha_acreditacion") // RECIBIDO: cuando se acreditó en cuenta
  fechaDebito       DateTime? @map("fecha_debito") // EMITIDO: cuando se debitó de cuenta

  // Endoso (solo RECIBIDO)
  endosadoAEntidadId Int?      @map("endosado_a_entidad_id") // A quién se endosó
  fechaEndoso        DateTime? @map("fecha_endoso")

  // Rechazo
  motivoRechazo String?   @map("motivo_rechazo")
  fechaRechazo  DateTime? @map("fecha_rechazo")

  // Movimiento de caja generado al concretarse
  // Se crea cuando pasa a ACREDITADO (recibido) o DEBITADO (emitido)
  movimientoCajaId Int? @unique @map("movimiento_caja_id")

  observaciones String?
  registradoPor Int      @map("registrado_por")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  entidad          Entidad?        @relation(fields: [entidadId], references: [id])
  socio            Socio?          @relation(fields: [socioId], references: [id])
  cajaOrigen       Caja?           @relation("ECheqCajaOrigen", fields: [cajaOrigenId], references: [id])
  cajaDestino      Caja?           @relation("ECheqCajaDestino", fields: [cajaDestinoId], references: [id])
  endosadoAEntidad Entidad?        @relation("ECheqEndoso", fields: [endosadoAEntidadId], references: [id])
  movimientoCaja   MovimientoCaja? @relation(fields: [movimientoCajaId], references: [id])
  registrador      Admin           @relation(fields: [registradoPor], references: [id])

  @@index([tipo])
  @@index([estado])
  @@index([fechaVencimiento])
  @@index([entidadId])
  @@index([cajaOrigenId])
  @@index([cajaDestinoId])
  @@map("echeqs")
}

