/**
 * POST /api/eventos/validar-entrada
 * Validar entrada por código QR
 * Permisos: EVENTOS_VALIDAR
 */
router.post('/validar-entrada', authAdmin, checkPermiso('EVENTOS_VALIDAR'), async (req, res) => {
  try {
    const { codigo, eventoId } = req.body

    if (!eventoId || !categoriaId || !cantidad || !comprador) {
      return res.status(400).json({
        error: 'Faltan campos requeridos: eventoId, categoriaId, cantidad, comprador'
      })
    }

    if (!comprador.nombre || !comprador.email) {
      return res.status(400).json({
        error: 'Datos de comprador incompletos (requiere nombre y email)'
      })
    }

    // Obtener evento y categoría
    const evento = await prisma.evento.findUnique({
      where: { id: parseInt(eventoId) },
      include: {
        categorias: {
          where: { id: parseInt(categoriaId) }
        }
      }
    })

    if (!evento) {
      return res.status(404).json({ error: 'Evento no encontrado' })
    }

    if (!evento.ventasHabilitadas || evento.estado === 'CANCELADO') {
      return res.status(400).json({ error: 'Evento no disponible para venta' })
    }

    const categoria = evento.categorias[0]

    if (!categoria || !categoria.activo) {
      return res.status(400).json({ error: 'Categoría no disponible' })
    }

    // Validar capacidad
    if (!evento.permiteSobreventa) {
      const nuevasVentas = evento.entradasVendidas + cantidad
      if (nuevasVentas > evento.capacidadTotal) {
        return res.status(400).json({
          error: `Capacidad agotada. Disponibles: ${evento.capacidadTotal - evento.entradasVendidas}`
        })
      }
    }

    // Determinar precio
    const precio = comprador.esSocio ? categoria.precioSocio : categoria.precioNoSocio
    const total = precio * cantidad

    // Crear preferencia de Mercado Pago
    const preference = {
      items: [{
        title: `${evento.nombre} - ${categoria.nombre}`,
        unit_price: Number(precio),
        quantity: cantidad,
        currency_id: 'ARS'
      }],
      payer: {
        name: comprador.nombre,
        email: comprador.email,
        identification: comprador.documento ? {
          type: 'DNI',
          number: comprador.documento
        } : undefined,
        phone: comprador.celular ? {
          number: comprador.celular
        } : undefined
      },
      back_urls: {
        success: `${process.env.FRONTEND_URL || 'http://localhost:5173'}/eventos/pago-exitoso`,
        failure: `${process.env.FRONTEND_URL || 'http://localhost:5173'}/eventos/pago-fallido`,
        pending: `${process.env.FRONTEND_URL || 'http://localhost:5173'}/eventos/pago-pendiente`
      },
      auto_return: 'approved',
      notification_url: `${process.env.BACKEND_URL || 'http://localhost:3000'}/api/eventos/mercadopago/webhook`,
      external_reference: JSON.stringify({
        eventoId,
        categoriaId,
        cantidad,
        comprador,
        origen: origen || 'PUBLIC'
      })
    }

    const response = await mercadopago.preferences.create(preference)

    return res.json({
      preferenceId: response.body.id,
      initPoint: response.body.init_point,
      sandboxInitPoint: response.body.sandbox_init_point
    })
  } catch (error) {
    console.error('Error al crear preferencia MP:', error)
    return res.status(500).json({ error: error.message || 'Error al crear preferencia de pago' })
  }
})

/**
 * POST /api/eventos/mercadopago/webhook
 * Webhook para recibir notificaciones de Mercado Pago
 * Público (MP envía sin autenticación)
 */
router.post('/mercadopago/webhook', async (req, res) => {
  try {
    const { action, data } = req.body

    if (!data || !data.id) {
      return res.status(200).send('OK')
    }

    if (action === 'payment.created' || action === 'payment.updated') {
      // Obtener detalles del pago desde Mercado Pago
      const payment = await mercadopago.payment.findById(data.id)

      if (payment.body.status === 'approved') {
        const externalRef = JSON.parse(payment.body.external_reference)
        const { eventoId, categoriaId, cantidad, comprador, origen } = externalRef

        // Validar que no se haya procesado antes (idempotencia)
        const existe = await prisma.entrada.findFirst({
          where: {
            eventoId: parseInt(eventoId),
            categoriaId: parseInt(categoriaId),
            documentoComprador: comprador.documento,
            emailComprador: comprador.email,
            fechaVenta: { gte: new Date(Date.now() - 5 * 60 * 1000) } // Últimos 5 min
          }
        })

        if (existe) {
          return res.status(200).send('OK') // Ya procesado
        }

        // Validar capacidad
        const evento = await prisma.evento.findUnique({
          where: { id: parseInt(eventoId) },
          include: {
            categorias: {
              where: { id: parseInt(categoriaId) }
            }
          }
        })

        if (!evento || !evento.ventasHabilitadas) {
          console.error('Evento no disponible para webhook MP')
          return res.status(200).send('OK')
        }

        const categoria = evento.categorias[0]

        if (!evento.permiteSobreventa) {
          const nuevasVentas = evento.entradasVendidas + cantidad
          if (nuevasVentas > evento.capacidadTotal) {
            console.error('Capacidad agotada en webhook MP')
            // TODO: Reembolsar (opcional)
            return res.status(200).send('OK')
          }
        }

        // Crear MovimientoCaja y Entradas
        await prisma.$transaction(async (tx) => {
          const cuentaContable = await tx.cuentaContable.findFirst({
            where: {
              OR: [
                { codigo: { contains: 'EVENTOS' } },
                { nombre: { contains: 'Eventos', mode: 'insensitive' } }
              ]
            }
          })

          const centroCosto = await tx.centroCosto.findFirst({
            where: { codigo: `EVENTOS_${evento.tipo}` }
          })

          const medioPagoMP = await tx.medioPago.findFirst({
            where: {
              OR: [
                { codigo: 'MERCADOPAGO' },
                { nombre: { contains: 'Mercado Pago', mode: 'insensitive' } }
              ]
            }
          })

          // Crear caja principal si no existe medioPagoMP
          const cajaDefault = await tx.caja.findFirst({
            where: { tipo: 'PRINCIPAL' }
          })

          const movimiento = await tx.movimientoCaja.create({
            data: {
              numero: `MP-${payment.body.id}`,
              cajaId: cajaDefault?.id || 1,
              tipo: 'INGRESO',
              cuentaContableId: cuentaContable?.id,
              centroCostoId: centroCosto?.id,
              monto: payment.body.transaction_amount,
              concepto: `Entrada MP - ${evento.nombre} - ${categoria.nombre}`,
              medioPagoId: medioPagoMP?.id,
              referencia: payment.body.id.toString()
            }
          })

          // Crear entradas
          const precio = payment.body.transaction_amount / cantidad

          for (let i = 0; i < cantidad; i++) {
            await tx.entrada.create({
              data: {
                codigo: uuidv4(),
                eventoId: parseInt(eventoId),
                categoriaId: parseInt(categoriaId),
                socioId: comprador.socioId ? parseInt(comprador.socioId) : null,
                nombreComprador: comprador.nombre,
                documentoComprador: comprador.documento,
                emailComprador: comprador.email,
                celularComprador: comprador.celular,
                precio,
                esSocio: !!comprador.socioId,
                canalVenta: origen || 'SITIO_WEB',
                movimientoCajaId: i === 0 ? movimiento.id : null
              }
            })
          }

          // Actualizar contadores
          await tx.evento.update({
            where: { id: parseInt(eventoId) },
            data: { entradasVendidas: { increment: cantidad } }
          })

          await tx.categoriaEntrada.update({
            where: { id: parseInt(categoriaId) },
            data: { entradasVendidas: { increment: cantidad } }
          })
        })

        console.log(`Entradas creadas exitosamente desde webhook MP - Payment ID: ${payment.body.id}`)
      }
    }

    return res.status(200).send('OK')
  } catch (error) {
    console.error('Error en webhook MP:', error)
    return res.status(200).send('OK') // Siempre responder 200 para no bloquear MP
  }
})

/**
 * GET /api/eventos/entradas-por-pago/:paymentId
 * Obtener entradas generadas por un pago de Mercado Pago
 * Público (para mostrar en página de confirmación)
