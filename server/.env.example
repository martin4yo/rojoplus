# Base de datos PostgreSQL
# Agregar connection_limit para limitar conexiones (recomendado: 10-20 en producción)
DATABASE_URL="postgresql://usuario:password@localhost:5432/rojoplus?schema=public&connection_limit=10"

# JWT para admin
JWT_SECRET=tu-secret-muy-largo-y-seguro
JWT_EXPIRES_IN=8h

# Email (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-email@gmail.com
SMTP_PASS=tu-app-password
SMTP_FROM=noreply@tudominio.com

# General
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001

# Descuento default
DEFAULT_DISCOUNT_PERCENT=10

# reCAPTCHA (obtener en https://www.google.com/recaptcha/admin)
RECAPTCHA_SECRET_KEY=tu-clave-secreta-de-recaptcha

# MercadoPago (obtener en https://www.mercadopago.com.ar/developers)
# Access Token de TEST o PRODUCTION
MERCADOPAGO_ACCESS_TOKEN=TEST-1234567890-123456-abcdef1234567890-123456789
MERCADOPAGO_PUBLIC_KEY=TEST-abcd1234-5678-9abc-def0-123456789abc

# MODO (pendiente integración)
MODO_API_KEY=tu-api-key-de-modo
MODO_STORE_ID=tu-store-id-de-modo

# Print Agent (agente de impresión para puestos Linux)
PRINT_AGENT_TOKEN=rojoplus-print-agent

# Anthropic Claude API (para ROJO IA - Asistente Inteligente)
# Obtener en: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-tu-clave-aqui
